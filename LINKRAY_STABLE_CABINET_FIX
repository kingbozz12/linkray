from pathlib import Path
import re

path = Path("src/linkrayWebsiteRoutes.js")
source = path.read_text(encoding="utf-8")
marker_start = "// LINKRAY_STABLE_CABINET_ROUTE_START"
marker_end = "// LINKRAY_STABLE_CABINET_ROUTE_END"

source = re.sub(
    rf"\n?{re.escape(marker_start)}[\s\S]*?{re.escape(marker_end)}\n?",
    "\n",
    source,
)

mount = re.search(
    r"export\s+function\s+mountLinkRayWebsiteRoutes\s*\(\s*app\s*\)\s*\{",
    source,
)
if not mount:
    raise SystemExit("Не найдена функция mountLinkRayWebsiteRoutes(app)")

route_candidates = []
for pattern in (r"\bapp\.use\s*\(", r"\bapp\.get\s*\(", r"\bapp\.post\s*\("):
    match = re.search(pattern, source[mount.end():])
    if match:
        route_candidates.append(mount.end() + match.start())

if not route_candidates:
    raise SystemExit("В mountLinkRayWebsiteRoutes не найдено место перед маршрутами")

insert_at = min(route_candidates)
has_headers = bool(re.search(r"\bfunction\s+applyWebsiteHeaders\b", source))

middleware = "applyWebsiteHeaders, " if has_headers else ""
block = f"""
  {marker_start}
  app.get(['/cabinet', '/cabinet/'], {middleware}(_req, res) => {{
    res.setHeader('Cache-Control', 'no-store, no-cache, must-revalidate');
    res.setHeader('Pragma', 'no-cache');
    res.sendFile(
      path.resolve(process.cwd(), 'public/linkray-site/cabinet-stable.html')
    );
  }});
  {marker_end}

"""

source = source[:insert_at] + block + source[insert_at:]
path.write_text(source, encoding="utf-8")
print("Маршрут /cabinet поставлен первым внутри mountLinkRayWebsiteRoutes")
