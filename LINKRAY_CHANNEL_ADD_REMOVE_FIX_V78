#!/usr/bin/env bash
set -Eeuo pipefail

cd /opt/linkray

FILE="src/index.js"
BACKUP="$(mktemp -d /tmp/linkray-channel-lifecycle.XXXXXX)"
DONE=0

restore_file() {
  echo
  echo "[ОТКАТ] Возвращаю прежний обработчик каналов"

  cp -f "$BACKUP/index.js" "$FILE"
  docker compose up -d --build app >/dev/null 2>&1 || true

  echo "[ОТКАТ] Предыдущая версия восстановлена"
}

on_error() {
  code=$?

  if [[ "$DONE" != "1" ]]; then
    restore_file
  fi

  exit "$code"
}

trap on_error ERR

echo "[1/8] Проверяю текущий код каналов"

test -f "$FILE"
cp -f "$FILE" "$BACKUP/index.js"

grep -q "async function lrV47NotifyConnected" "$FILE"
grep -q "async function lrV47HandleBotRemoved" "$FILE"
grep -q "async function lrSigChannels" "$FILE"
grep -q "async function __lrCh3HandleBotRemoved" "$FILE"

echo "[2/8] Исправляю список автоподписей"

python3 - <<'PY'
from pathlib import Path
import re

path = Path("src/index.js")
source = path.read_text(encoding="utf-8")

replacements = [
    (
        "SELECT * FROM channels WHERE id = ANY($1::int[]) ORDER BY id",
        "SELECT * FROM channels "
        "WHERE id = ANY($1::int[]) "
        "AND COALESCE(is_active,true)=true "
        "ORDER BY id",
    ),
    (
        "SELECT * FROM channels ORDER BY id",
        "SELECT * FROM channels "
        "WHERE COALESCE(is_active,true)=true "
        "ORDER BY id",
    ),
    (
        "SELECT * FROM channels WHERE id=$1 LIMIT 1",
        "SELECT * FROM channels "
        "WHERE id=$1 "
        "AND COALESCE(is_active,true)=true "
        "LIMIT 1",
    ),
]

changed = 0

for old, new in replacements:
    if old in source:
        source = source.replace(old, new, 1)
        changed += 1
    elif new in source:
        changed += 1
    else:
        raise SystemExit(
            f"Не найден запрос автоподписей: {old}"
        )

path.write_text(source, encoding="utf-8")

if changed != 3:
    raise SystemExit(
        f"Обновлено запросов: {changed}, ожидалось 3"
    )

print("Неактивные каналы исключены из автоподписей")
PY

echo "[3/8] Устанавливаю единый обработчик добавления и удаления"

python3 - <<'PY'
from pathlib import Path
import re

path = Path("src/index.js")
source = path.read_text(encoding="utf-8")

start = "/* LR_CHANNEL_LIFECYCLE_V78_START */"
end = "/* LR_CHANNEL_LIFECYCLE_V78_END */"

source = re.sub(
    rf"\s*{re.escape(start)}[\s\S]*?{re.escape(end)}\s*",
    "\n",
    source,
)

block = r'''
/* LR_CHANNEL_LIFECYCLE_V78_START */
/*
 * Единая изолированная правка жизненного цикла каналов.
 * Автопостинг, редактор и публикации не изменяются.
 */
const lrV78OriginalChannels = lrV47Channels;
const lrV78OriginalBotRemoved = lrV47HandleBotRemoved;

lrV47Channels = async function lrV78ActiveChannelsOnly() {
  const rows = await lrV78OriginalChannels();

  return lrV47Rows(rows).filter((channel) => {
    const value = channel?.is_active;

    if (value === false || value === 0 || value === '0') {
      return false;
    }

    if (
      typeof value === 'string' &&
      ['false', 'off', 'inactive', 'deleted']
        .includes(value.trim().toLowerCase())
    ) {
      return false;
    }

    return true;
  });
};

lrV47NotifyConnected =
  async function lrV78NotifyConnected(chatId, key, channel) {
    if (!channel) return false;

    const stateKey =
      `lr_v47_connected_notified:${chatId}:${channel.id}`;

    const previous = await lrV47StateGet(stateKey);
    const previousTs = Number(previous?.ts || 0);

    /*
     * Подавляем только второй webhook одного подключения.
     * Старая запись больше не блокирует повторное подключение.
     */
    if (
      previous &&
      previousTs > 0 &&
      Date.now() - previousTs < 20_000
    ) {
      console.log(
        '[channel lifecycle v78] duplicate add webhook skipped',
        JSON.stringify({
          chatId,
          id: channel.id,
        }),
      );

      return true;
    }

    if (previous) {
      await lrV47StateDelLike([stateKey]);
    }

    const ok = await lrV47Msg(
      chatId,
      `✅ Канал подключён к LinkRay

${lrV47Esc(channel.title || 'Канал')}

Канал сохранён и доступен для постов, автоподписей, аналитики и отчётов.`,
      [
        [
          lrV47Btn(
            '⬅️ Главное меню',
            'main:menu',
          ),
        ],
      ],
      'html',
    );

    if (ok) {
      await lrV47StateSet(stateKey, {
        chatId,
        key,
        channel: {
          id: channel.id,
          max_chat_id: channel.max_chat_id,
          title: channel.title,
        },
        ts: Date.now(),
      });

      console.log(
        '[channel lifecycle v78] connected notification sent',
        JSON.stringify({
          chatId,
          id: channel.id,
          maxChatId: channel.max_chat_id,
        }),
      );
    }

    return ok;
  };

lrV47HandleBotRemoved =
  async function lrV78HandleBotRemoved(update) {
    let robustRemoved = false;

    try {
      robustRemoved =
        typeof __lrCh3IsBotRemoved === 'function' &&
        __lrCh3IsBotRemoved(update);
    } catch {}

    const type = lrV47Type(update);

    if (
      !robustRemoved &&
      !/bot_removed|bot_left|chat_deleted|bot_deleted|member_removed|chat_member_removed/i
        .test(type)
    ) {
      return false;
    }

    /*
     * Старые ключи подтверждения удаляются сразу.
     * После повторного добавления того же канала
     * пользователь снова получит подтверждение.
     */
    await query(
      `
        DELETE FROM lr_bot_state
        WHERE key LIKE 'lr_v47_connected_notified:%'
           OR key LIKE 'lr_v31_channel_connected_notified:%'
           OR key LIKE 'lr_v35_channel_connected_notified:%'
      `,
    ).catch((error) => {
      console.error(
        '[channel lifecycle v78] clear notification state failed',
        error?.message || error,
      );
    });

    /*
     * Используем уже существующую полную очистку:
     * она удаляет канал и все таблицы, связанные через channel_id,
     * а затем отправляет одно уведомление владельцу.
     */
    if (
      typeof __lrCh3HandleBotRemoved === 'function'
    ) {
      try {
        const handled =
          await __lrCh3HandleBotRemoved(update);

        if (handled) {
          console.log(
            '[channel lifecycle v78] full removal completed',
            JSON.stringify({
              type,
              chatId: lrV47ChatId(update),
            }),
          );

          return true;
        }
      } catch (error) {
        console.error(
          '[channel lifecycle v78] full removal failed',
          error?.stack || error?.message || error,
        );
      }
    }

    /*
     * Резервный путь для неизвестного формата события MAX.
     * Даже здесь канал и подпись исчезают из рабочих меню.
     */
    const removedChatId = lrV47ChatId(update);

    if (removedChatId) {
      const found = lrV47Rows(
        await query(
          `
            SELECT id
            FROM channels
            WHERE max_chat_id::text=$1
          `,
          [String(removedChatId)],
        ).catch(() => []),
      );

      const ids = found
        .map((row) => Number(row.id))
        .filter(Number.isFinite);

      if (ids.length) {
        await query(
          `
            UPDATE channels
            SET is_active=false,
                updated_at=now()
            WHERE id=ANY($1::int[])
          `,
          [ids],
        ).catch(() => {});

        await query(
          `
            UPDATE channel_signatures
            SET is_active=false,
                updated_at=now()
            WHERE channel_id=ANY($1::int[])
          `,
          [ids],
        ).catch(() => {});

        await query(
          `
            DELETE FROM lr_user_channels
            WHERE channel_id=ANY($1::int[])
          `,
          [ids],
        ).catch(() => {});

        await query(
          `
            UPDATE scheduled_posts
            SET status='deleted',
                updated_at=now()
            WHERE channel_id=ANY($1::int[])
              AND status::text='scheduled'
          `,
          [ids],
        ).catch(() => {});
      }
    }

    return lrV78OriginalBotRemoved(update);
  };

console.log(
  '[channel lifecycle v78] installed: add confirmation, full removal, active lists',
);
/* LR_CHANNEL_LIFECYCLE_V78_END */
'''

anchor = "await ensureDb();"

position = source.rfind(anchor)

if position < 0:
    raise SystemExit(
        "Не найдено безопасное место перед запуском приложения"
    )

source = (
    source[:position]
    + block
    + "\n"
    + source[position:]
)

path.write_text(source, encoding="utf-8")

checks = [
    "LR_CHANNEL_LIFECYCLE_V78_START",
    "lrV78NotifyConnected",
    "lrV78HandleBotRemoved",
    "lrV78ActiveChannelsOnly",
]

for check in checks:
    if source.count(check) < 1:
        raise SystemExit(
            f"Не установлен блок: {check}"
        )

print("Единый обработчик каналов установлен")
PY

echo "[4/8] Очищаю уже оставшиеся неактивные связи"

docker exec -i linkray-postgres sh -lc '
  psql -v ON_ERROR_STOP=1 \
    -U "${POSTGRES_USER:-linkray}" \
    -d "${POSTGRES_DB:-linkray}"
' <<'SQL'
UPDATE public.channel_signatures s
SET is_active=false,
    updated_at=NOW()
FROM public.channels c
WHERE s.channel_id=c.id
  AND COALESCE(c.is_active, true)=false
  AND COALESCE(s.is_active, true)=true;

DELETE FROM public.lr_user_channels uc
USING public.channels c
WHERE uc.channel_id=c.id
  AND COALESCE(c.is_active, true)=false;

DELETE FROM public.lr_bot_state
WHERE key LIKE 'lr_v47_connected_notified:%'
   OR key LIKE 'lr_v31_channel_connected_notified:%'
   OR key LIKE 'lr_v35_channel_connected_notified:%';
SQL

echo "[5/8] Проверяю синтаксис"

node --check "$FILE"

grep -q \
  "LR_CHANNEL_LIFECYCLE_V78_START" \
  "$FILE"

grep -q \
  "COALESCE(is_active,true)=true" \
  "$FILE"

echo "[6/8] Пересобираю приложение"

docker compose up -d --build app
sleep 16

echo "[7/8] Проверяю запуск"

if ! docker compose ps \
  --status running \
  --services |
  grep -qx "app"
then
  echo "Контейнер app не запущен"
  exit 1
fi

if docker logs --since 70s linkray-app 2>&1 |
   grep -E \
     "SyntaxError|ReferenceError|ERR_MODULE_NOT_FOUND|Cannot find module"; then
  echo "Обнаружена ошибка запуска"
  exit 1
fi

docker logs --since 70s linkray-app 2>&1 |
  grep -F \
    "[channel lifecycle v78] installed" |
  tail -n 1

echo "[8/8] Сохраняю исправление"

git add -- "$FILE"

if ! git diff --cached --quiet; then
  git commit -m \
    "Fix LinkRay channel add and removal lifecycle"
  git push origin HEAD:main
else
  echo "Исправление уже установлено"
fi

DONE=1
trap - ERR
rm -rf "$BACKUP"

echo
echo "============================================================"
echo "ДОБАВЛЕНИЕ И УДАЛЕНИЕ КАНАЛОВ ИСПРАВЛЕНО"
echo
echo "• подтверждение приходит при каждом новом подключении"
echo "• дубли одного webhook по-прежнему подавляются"
echo "• удаление бота запускает полную очистку канала"
echo "• канал исчезает из Studio и автоподписей"
echo "• старые подписи и связи не остаются активными"
echo "• автопостинг и редактор постов не изменялись"
echo "============================================================"
