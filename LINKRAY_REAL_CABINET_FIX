                          <span class="${
                            channel.antifraudEnabled
                              ? 'is-enabled'
                              : 'is-disabled'
                          }">
                            ${escapeHtml(channel.antifraudStatus)}
                          </span>
                          <span>
                            События 24 ч:
                            ${formatNumber(channel.alertCount24)}
                          </span>
                        </div>
                      </article>
                    `,
                  )
                  .join('')
              : `
                <div class="lr-real-empty">
                  <strong>Нет подключённых каналов</strong>
                  <p>
