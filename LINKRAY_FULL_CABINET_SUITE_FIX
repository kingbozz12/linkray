  justify-content: space-between;
  gap: 14px;
}

.profile-row span {
  color: var(--muted);
  font-size: 12px;
}

.profile-row strong {
  text-align: right;
  font-size: 13px;
}

.channel-list {
  display: grid;
  gap: 12px;
}

.channel-card {
  overflow: hidden;
}

.channel-summary {
  width: 100%;
  display: block;
  border: 0;
  padding: 17px;
  background: transparent;
  color: inherit;
  text-align: left;
}

.channel-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.channel-title {
  min-width: 0;
}

.channel-title h3 {
  margin: 0 0 5px;
  overflow: hidden;
  font-size: 17px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.channel-title p {
  margin: 0;
  color: var(--muted);
  font-size: 11px;
}

.channel-chevron {
  color: var(--muted);
  font-size: 20px;
  transition: transform .18s ease;
}

.channel-card.open .channel-chevron {
  transform: rotate(180deg);
}

