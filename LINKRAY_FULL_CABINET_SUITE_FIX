  background: rgba(255,255,255,.025);
}

.notice {
  display: grid;
  grid-template-columns: 10px minmax(0,1fr);
  gap: 10px;
}

.notice-dot {
  width: 9px;
  height: 9px;
  margin-top: 5px;
  border-radius: 50%;
  background: var(--blue);
}

.notice.medium .notice-dot { background: var(--amber); }
.notice.high .notice-dot { background: var(--red); }

.notice strong,
.post-row strong {
  display: block;
  margin-bottom: 3px;
  font-size: 14px;
}

.notice p,
.post-row p {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.42;
}

.post-row {
  display: grid;
  grid-template-columns: minmax(0,1fr) auto;
  gap: 10px;
  align-items: center;
}

.post-meta {
  color: var(--muted);
  font-size: 11px;
