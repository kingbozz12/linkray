  border-radius: 9px;
  padding: 0 8px;
  background: transparent;
  color: var(--muted);
  font-size: 10px;
}

.periods button.active {
  border-color: rgba(89,221,160,.38);
  background: rgba(89,221,160,.12);
  color: #baf4d7;
}

.chart {
  width: 100%;
  min-height: 122px;
  display: block;
}

.chart-empty {
  min-height: 100px;
  display: grid;
  place-items: center;
  color: var(--muted);
  font-size: 12px;
}

.chart-label {
  fill: #7f96a8;
  font-size: 8px;
}

.chart-line-subscribers {
  fill: none;
  stroke: #59dda0;
  stroke-width: 3;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.chart-line-views {
  fill: none;
  stroke: #73b7ff;
  stroke-width: 3;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.detail-section {
  margin-top: 14px;
}

.detail-section h4 {
  margin: 0 0 9px;
  font-size: 14px;
}

.antifraud-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  border: 1px solid rgba(255,255,255,.07);
  border-radius: 15px;
  padding: 12px;
  background: rgba(255,255,255,.025);
}

.antifraud-row p {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: 11px;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-top: 13px;
}

.primary,
.secondary {
  min-height: 46px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  padding: 0 12px;
  font-weight: 800;
  font-size: 12px;
  text-decoration: none;
}

.primary {
  border: 0;
  background: linear-gradient(135deg, #6ee7a8, #37c98a);
  color: var(--green-dark);
}

.secondary {
  border: 1px solid var(--line);
  background: rgba(255,255,255,.045);
  color: var(--text);
}

.full-width { grid-column: 1 / -1; }
.positive { color: var(--green) !important; }
.negative { color: var(--red) !important; }
.muted { color: var(--muted) !important; }

.empty-card,
.error-card {
  padding: 23px;
}

.empty-card h2,
.error-card h1 {
  margin-top: 0;
}

.empty-card p,
.error-card p {
  color: var(--muted);
  line-height: 1.55;
}

.tab-view[hidden] {
  display: none !important;
}

.bottom-nav {
  position: fixed;
  z-index: 50;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: calc(82px + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: repeat(3,1fr);
  padding: 8px 10px env(safe-area-inset-bottom);
  border-top: 1px solid var(--line);
  background: rgba(4,16,27,.96);
  backdrop-filter: blur(18px);
}

.bottom-nav button,
.bottom-nav a {
  min-width: 0;
  border: 0;
  border-radius: 17px;
  background: transparent;
  color: #8298aa;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  font-size: 12px;
}

.bottom-nav .active {
  background: rgba(89,221,160,.11);
  color: #d9f8e9;
}

.nav-icon { font-size: 22px; }

@media (min-width: 760px) {
  .cabinet-shell {
    max-width: 1000px;
    margin: 0 auto;
    padding-left: 28px;
    padding-right: 28px;
  }

  .summary {
    grid-template-columns: repeat(4,1fr);
  }

  .channel-list {
    grid-template-columns: repeat(2,minmax(0,1fr));
    align-items: start;
  }

  .channel-card.open {
    grid-column: 1 / -1;
  }

  .detail-grid {
    grid-template-columns: repeat(4,minmax(0,1fr));
  }
}
