}

.status-published,
.risk-safe {
  background: rgba(89,221,160,.13);
  color: #8aebba;
}

.status-error,
.risk-high {
  background: rgba(255,145,165,.13);
  color: #ffb2c0;
}

.status-deleted,
.risk-medium {
  background: rgba(255,201,107,.13);
  color: #ffd894;
}

.profile-row {
  display: flex;
