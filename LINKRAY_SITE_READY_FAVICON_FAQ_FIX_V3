cp -f "$ICON_TMP/64.png" "$SITE/favicon-64.png"
cp -f "$ICON_TMP/180.png" "$SITE/apple-touch-icon.png"
cp -f "$ICON_TMP/192.png" "$SITE/icon-192.png"
cp -f "$ICON_TMP/512.png" "$SITE/icon-512.png"

