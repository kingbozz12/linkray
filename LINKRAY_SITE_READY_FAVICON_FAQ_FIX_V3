icon_block = f'''
<!-- LINKRAY_BROWSER_IDENTITY_V1_START -->
<link rel="icon"
      href="/favicon.ico?v={version}"
      sizes="any">
<link rel="icon"
      type="image/png"
      sizes="32x32"
      href="/linkray-site/favicon-32.png?v={version}">
<link rel="icon"
      type="image/png"
      sizes="64x64"
      href="/linkray-site/favicon-64.png?v={version}">
<link rel="shortcut icon"
      href="/favicon.ico?v={version}">
<link rel="apple-touch-icon"
      sizes="180x180"
      href="/linkray-site/apple-touch-icon.png?v={version}">
<link rel="manifest"
      href="/linkray-site/site.webmanifest?v={version}">
<meta name="application-name" content="LinkRay">
<meta name="apple-mobile-web-app-title" content="LinkRay">
<!-- LINKRAY_BROWSER_IDENTITY_V1_END -->
'''.strip()

for html_path in site.glob("*.html"):
    source = html_path.read_text(encoding="utf-8")

    source = re.sub(
        r"\s*<!-- LINKRAY_BROWSER_IDENTITY_V1_START -->"
        r"[\s\S]*?"
        r"<!-- LINKRAY_BROWSER_IDENTITY_V1_END -->\s*",
        "\n",
        source,
        flags=re.I,
    )

    source = re.sub(
        r"\s*<link\b[^>]*\brel\s*=\s*"
        r"['\"](?:icon|shortcut icon|apple-touch-icon|manifest)"
        r"['\"][^>]*>\s*",
        "\n",
        source,
        flags=re.I,
    )

    source = re.sub(
        r"\s*<meta\b[^>]*\bname\s*=\s*"
        r"['\"](?:application-name|apple-mobile-web-app-title)"
        r"['\"][^>]*>\s*",
        "\n",
        source,
        flags=re.I,
    )

    viewport = re.search(
        r"<meta\b[^>]*\bname\s*=\s*"
        r"['\"]viewport['\"][^>]*>",
        source,
        flags=re.I,
    )

    if viewport:
        insert_at = viewport.end()
    else:
        head = re.search(r"<head[^>]*>", source, flags=re.I)

        if not head:
            raise SystemExit(
                f"В {html_path} не найден <head>"
            )

        insert_at = head.end()

    source = (
        source[:insert_at]
        + "\n"
        + icon_block
        + source[insert_at:]
    )

    html_path.write_text(source, encoding="utf-8")

print("Manifest и HTML-значки обновлены")
