#!/usr/bin/env bash
set -Eeuo pipefail

cd /opt/linkray

VERSION="20260806-site-ready-favicon-faq-v1"
SITE="public/linkray-site"
INDEX="$SITE/index.html"
BACKUP="$(mktemp -d /tmp/linkray-site-ready.XXXXXX)"
DONE=0

ROOT_ICON_FILES=(
  "public/favicon.ico"
  "public/favicon.png"
  "public/favicon-32.png"
  "public/favicon-64.png"
  "public/apple-touch-icon.png"
  "public/icon-192.png"
  "public/icon-512.png"
)

restore_all() {
  echo
  echo "[ОТКАТ] Возвращаю предыдущую версию сайта"

  rm -rf "$SITE"
  cp -a "$BACKUP/linkray-site" "$SITE"

  for file in "${ROOT_ICON_FILES[@]}"; do
    key="$(printf '%s' "$file" | tr '/' '_')"

    if [[ -f "$BACKUP/$key.exists" ]]; then
      cp -f "$BACKUP/$key" "$file"
    else
      rm -f "$file"
    fi
  done

  docker compose up -d --build app >/dev/null 2>&1 || true
  echo "[ОТКАТ] Предыдущая версия восстановлена"
}

on_error() {
  code=$?

  if [[ "$DONE" != "1" ]]; then
    restore_all
  fi

  exit "$code"
}

trap on_error ERR

echo "[1/9] Проверяю текущий сайт"

test -f "$INDEX"
test -f "$SITE/linkray-logo-exact.webp"

cp -a "$SITE" "$BACKUP/linkray-site"

for file in "${ROOT_ICON_FILES[@]}"; do
  key="$(printf '%s' "$file" | tr '/' '_')"

  if [[ -f "$file" ]]; then
    cp -f "$file" "$BACKUP/$key"
    touch "$BACKUP/$key.exists"
  fi
done

echo "[2/9] Создаю настоящие PNG-значки LinkRay"

ICON_SOURCE="$SITE/linkray-logo-exact.webp"
ICON_TMP="$(mktemp -d /tmp/linkray-icons.XXXXXX)"
ICON_READY=0

test -f "$ICON_SOURCE"

# Способ 1: sharp внутри уже работающего контейнера LinkRay.
if docker exec linkray-app node --input-type=module -e '
  import fs from "node:fs/promises";
  import sharpModule from "sharp";

  const sharp = sharpModule.default || sharpModule;
  const source = "/app/public/linkray-site/linkray-logo-exact.webp";
  const output = "/tmp/linkray-icons-v3";

  await fs.rm(output, { recursive: true, force: true });
  await fs.mkdir(output, { recursive: true });

  for (const size of [16, 32, 64, 180, 192, 512]) {
    await sharp(source)
      .resize(size, size, {
        fit: "cover",
        position: "centre",
      })
      .png({
        compressionLevel: 9,
        adaptiveFiltering: true,
      })
      .toFile(`${output}/${size}.png`);
  }
' >/dev/null 2>&1; then
  if docker cp \
    linkray-app:/tmp/linkray-icons-v3/. \
    "$ICON_TMP/" >/dev/null 2>&1; then
    ICON_READY=1
    echo "PNG созданы через sharp внутри linkray-app"
  fi
fi

# Способ 2: Pillow на VPS.
if [[ "$ICON_READY" != "1" ]] &&
   python3 -c 'from PIL import Image' >/dev/null 2>&1; then
  ICON_SOURCE="$ICON_SOURCE" ICON_TMP="$ICON_TMP" python3 - <<'PY'
from pathlib import Path
from PIL import Image
import os

source = Path(os.environ["ICON_SOURCE"])
output = Path(os.environ["ICON_TMP"])
output.mkdir(parents=True, exist_ok=True)

with Image.open(source) as original:
    image = original.convert("RGBA")

    for size in (16, 32, 64, 180, 192, 512):
        resized = image.resize(
            (size, size),
            Image.Resampling.LANCZOS,
        )
        resized.save(
            output / f"{size}.png",
            format="PNG",
            optimize=True,
        )
PY
  ICON_READY=1
  echo "PNG созданы через Pillow"
fi

# Способ 3: ImageMagick.
if [[ "$ICON_READY" != "1" ]]; then
  IM_COMMAND=""

  if command -v magick >/dev/null 2>&1; then
    IM_COMMAND="magick"
  elif command -v convert >/dev/null 2>&1; then
    IM_COMMAND="convert"
  fi

  if [[ -n "$IM_COMMAND" ]]; then
    IMAGE_MAGICK_OK=1

    for size in 16 32 64 180 192 512; do
      if ! "$IM_COMMAND" "$ICON_SOURCE" \
        -resize "${size}x${size}^" \
        -gravity center \
        -extent "${size}x${size}" \
        "$ICON_TMP/${size}.png" >/dev/null 2>&1; then
        IMAGE_MAGICK_OK=0
        break
      fi
    done

    if [[ "$IMAGE_MAGICK_OK" == "1" ]]; then
      ICON_READY=1
      echo "PNG созданы через ImageMagick"
    fi
  fi
fi

# Способ 4: FFmpeg.
if [[ "$ICON_READY" != "1" ]] &&
   command -v ffmpeg >/dev/null 2>&1; then
  FFMPEG_OK=1

  for size in 16 32 64 180 192 512; do
    if ! ffmpeg -loglevel error -y \
      -i "$ICON_SOURCE" \
      -vf "scale=${size}:${size}:force_original_aspect_ratio=increase,crop=${size}:${size}" \
      -frames:v 1 \
      "$ICON_TMP/${size}.png"; then
      FFMPEG_OK=0
      break
    fi
  done

  if [[ "$FFMPEG_OK" == "1" ]]; then
    ICON_READY=1
    echo "PNG созданы через FFmpeg"
  fi
fi

if [[ "$ICON_READY" != "1" ]]; then
  echo "Не удалось преобразовать WebP-логотип в PNG ни одним способом."
  echo "Сайт не изменялся."
  exit 1
fi

echo "[2.1/9] Проверяю полученные изображения"

ICON_TMP="$ICON_TMP" python3 - <<'PY'
from pathlib import Path
import os
import struct

directory = Path(os.environ["ICON_TMP"])
signature = b"\x89PNG\r\n\x1a\n"

for size in (16, 32, 64, 180, 192, 512):
    file = directory / f"{size}.png"

    if not file.exists():
        raise SystemExit(
            f"Не создан файл {file.name}"
        )

    data = file.read_bytes()

    if not data.startswith(signature) or len(data) < 24:
        raise SystemExit(
            f"{file.name} не является PNG"
        )

    width = struct.unpack(">I", data[16:20])[0]
    height = struct.unpack(">I", data[20:24])[0]

    if (width, height) != (size, size):
        raise SystemExit(
            f"{file.name}: получен размер {width}×{height}, "
            f"ожидался {size}×{size}"
        )

print("Все размеры PNG проверены")
