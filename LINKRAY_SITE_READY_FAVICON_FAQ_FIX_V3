cp -f "$ICON_TMP/64.png" "public/favicon-64.png"
cp -f "$ICON_TMP/180.png" "public/apple-touch-icon.png"
cp -f "$ICON_TMP/192.png" "public/icon-192.png"
cp -f "$ICON_TMP/512.png" "public/icon-512.png"

ICON_TMP="$ICON_TMP" python3 - <<'PY'
from pathlib import Path
import os
import struct

png = (
    Path(os.environ["ICON_TMP"]) / "64.png"
).read_bytes()

header = struct.pack("<HHH", 0, 1, 1)
entry = struct.pack(
    "<BBBBHHII",
    64,
    64,
    0,
    0,
    1,
    32,
    len(png),
    22,
)

Path("public/favicon.ico").write_bytes(
    header + entry + png
)

print("favicon.ico создан")
