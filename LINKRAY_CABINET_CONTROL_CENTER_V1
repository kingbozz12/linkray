from pathlib import Path
import re

path = Path("public/linkray-site/cabinet-stable.html")
source = path.read_text(encoding="utf-8")
version = "20260806-cabinet-control-center-v1"

start = "<!-- LINKRAY_CABINET_CONTROL_CENTER_V1_START -->"
end = "<!-- LINKRAY_CABINET_CONTROL_CENTER_V1_END -->"

source = re.sub(
    rf"\s*{re.escape(start)}[\s\S]*?{re.escape(end)}\s*",
    "\n",
    source,
    flags=re.I,
)

block = f'''
{start}
<link rel="stylesheet"
      href="/linkray-site/cabinet-control-center.css?v={version}">
<script src="/linkray-site/cabinet-control-center.js?v={version}"
        defer></script>
{end}
'''.strip()

head_close = re.search(r"</head>", source, flags=re.I)

if not head_close:
    raise SystemExit("В cabinet-stable.html не найден </head>")

source = (
    source[:head_close.start()]
    + "\n"
    + block
    + "\n"
    + source[head_close.start():]
)

path.write_text(source, encoding="utf-8")

if source.count(start) != 1:
    raise SystemExit("Расширение кабинета подключено некорректно")

print("Расширение подключено без нового пункта меню")
