echo "[3/7] Подключаю загрузчик прямо к странице кабинета"

python3 - <<'PY'
from pathlib import Path
import re

root = Path("public/linkray-site")
version = "20260730-cabinet-boot-2"

candidates = []
for file in root.rglob("*.html"):
    text = file.read_text(encoding="utf-8")
    score = 0
    if "Загружаем LinkRay" in text:
        score += 10
    if "Studio в MAX" in text:
        score += 5
    if "Каналы" in text and "Обзор" in text:
        score += 3
    if "cabinet" in file.name.lower():
        score += 2
    if score:
        candidates.append((score, file))

if not candidates:
    raise SystemExit("Не найден HTML-файл кабинета")

max_score = max(score for score, _ in candidates)
selected = [file for score, file in candidates if score == max_score]

tag = f'<script src="/cabinet-boot.js?v={version}" defer></script>'

for file in selected:
    text = file.read_text(encoding="utf-8")
    text = re.sub(
        r'\s*<script[^>]+src=["\']/cabinet-boot\.js(?:\?[^"\']*)?["\'][^>]*></script>',
        '',
        text,
        flags=re.I,
    )
    if "</body>" in text:
        text = text.replace("</body>", f"  {tag}\n</body>")
    else:
        text += "\n" + tag + "\n"
    file.write_text(text, encoding="utf-8")
    print("Подключён загрузчик:", file)

for file in root.rglob("*.html"):
    text = file.read_text(encoding="utf-8")
    text = re.sub(
        r'(?P<path>(?:\.\./)?styles\.css)(?:\?v=[^"\']*)?',
        rf'\g<path>?v={version}',
        text,
    )
    file.write_text(text, encoding="utf-8")
