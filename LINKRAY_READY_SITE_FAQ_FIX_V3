#!/usr/bin/env bash
set -Eeuo pipefail

cd /opt/linkray

INDEX="public/linkray-site/index.html"
BACKUP="$(mktemp -d /tmp/linkray-faq-ready-v3.XXXXXX)"
DONE=0

restore_index() {
  echo
  echo "[ОТКАТ] Возвращаю прежний FAQ"
  cp -f "$BACKUP/index.html" "$INDEX"
  docker compose up -d --build app >/dev/null 2>&1 || true
  echo "[ОТКАТ] Предыдущий FAQ восстановлен"
}

on_error() {
  code=$?

  if [[ "$DONE" != "1" ]]; then
    restore_index
  fi

  exit "$code"
}

trap on_error ERR

echo "[1/7] Проверяю главную страницу"

test -f "$INDEX"
cp -f "$INDEX" "$BACKUP/index.html"

echo "[2/7] Заменяю содержимое двух списков FAQ"

python3 - <<'PY'
from pathlib import Path
import html
import json
import re

path = Path("public/linkray-site/index.html")
source = path.read_text(encoding="utf-8")

questions = [
    (
        "Как войти в личный кабинет?",
        "Нажмите «Открыть кабинет», введите свой ID LinkRay "
        "и подтвердите вход кодом, который бот отправит вам в MAX.",
    ),
    (
        "Как подключить канал?",
        "Добавьте LinkRay администратором канала с необходимыми "
        "правами и перешлите боту любой пост из этого канала.",
    ),
    (
        "Что показывает личный кабинет?",
        "В кабинете доступны подключённые каналы, подписчики, "
        "просмотры, прирост аудитории, ER, графики, состояние "
        "аналитики, AntiFraud и последние публикации.",
    ),
    (
        "Сайт заменяет бота?",
        "Нет. Сайт и бот работают вместе: кабинет показывает "
        "данные и отчёты, а создание и редактирование публикаций "
        "выполняется в LinkRay Studio внутри MAX.",
    ),
    (
        "Когда становится доступен полный отчёт?",
        "Текущие показатели появляются по мере сбора данных. "
        "Полный графический отчёт становится доступен после "
        "накопления минимум 24 часов аналитики по каналу.",
    ),
    (
        "Сайт работает на телефоне?",
        "Да. Главная страница и личный кабинет адаптированы "
        "для телефонов, планшетов и компьютеров и открываются "
        "в обычном браузере.",
    ),
]

def get_attribute(tag, name):
    match = re.search(
        rf"\b{re.escape(name)}\s*=\s*(['\"])(.*?)\1",
        tag,
        flags=re.I | re.S,
    )
    return match.group(2).strip() if match else ""

def class_tokens(tag):
    return set(get_attribute(tag, "class").split())

def find_div_content_bounds(document, required_classes):
    required = set(required_classes)
    opening = None

    for match in re.finditer(
        r"<div\b[^>]*>",
        document,
        flags=re.I | re.S,
    ):
        if required.issubset(class_tokens(match.group(0))):
            opening = match
            break

    if opening is None:
        return None

    depth = 0

    for token in re.finditer(
        r"</?div\b[^>]*>",
        document[opening.start():],
        flags=re.I | re.S,
    ):
        tag = token.group(0)
        absolute_start = opening.start() + token.start()
        absolute_end = opening.start() + token.end()

        if tag.lower().startswith("</div"):
            depth -= 1

            if depth == 0:
                return opening.end(), absolute_start
        else:
            depth += 1

    raise SystemExit(
        "Найден FAQ-контейнер без закрывающего тега </div>"
    )

def details_html(indent):
    blocks = []

    for question, answer in questions:
        blocks.append(
            indent + "<details>\n"
            + indent + "  <summary>"
            + html.escape(question)
            + "</summary>\n"
            + indent + "  <p>"
            + html.escape(answer)
            + "</p>\n"
            + indent + "</details>"
        )

    return "\n" + "\n\n".join(blocks) + "\n"

mobile_bounds = find_div_content_bounds(
    source,
    {"lr-m-faq-list"},
)

desktop_bounds = find_div_content_bounds(
    source,
    {"faq-list"},
)

if mobile_bounds is None:
    raise SystemExit(
        "Не найден мобильный контейнер .lr-m-faq-list"
    )

if desktop_bounds is None:
    raise SystemExit(
        "Не найден основной контейнер .faq-list"
    )

replacements = [
    (
        mobile_bounds[0],
        mobile_bounds[1],
        details_html("    "),
    ),
    (
        desktop_bounds[0],
        desktop_bounds[1],
        details_html("      "),
    ),
]

for start, end, replacement in sorted(
    replacements,
    key=lambda item: item[0],
    reverse=True,
):
    source = source[:start] + replacement + source[end:]

# Обновляем заголовок и описание обоих FAQ.
source = re.sub(
    r"<h2>\s*Коротко о LinkRay\s*</h2>",
    "<h2>Частые вопросы</h2>",
    source,
    flags=re.I,
)

source = re.sub(
    r"<p>\s*Основные ответы перед подключением\.\s*</p>",
    "<p>Вход, подключение каналов, кабинет и отчёты.</p>",
    source,
    flags=re.I,
)

# Обновляем подпись мобильного блока «Вопросы» на FAQ.
source = re.sub(
    r"(<div\b[^>]*class\s*=\s*['\"][^'\"]*lr-m-section-head"
    r"[^'\"]*['\"][^>]*>[\s\S]*?<span>)"
    r"\s*Вопросы\s*"
    r"(</span>)",
    r"\1FAQ\2",
    source,
    count=1,
    flags=re.I,
)

faq_entities = [
    {
        "@type": "Question",
        "name": question,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": answer,
        },
    }
    for question, answer in questions
]

schema_updated = False

for match in list(re.finditer(
    r"<script\b([^>]*)>([\s\S]*?)</script>",
    source,
    flags=re.I,
)):
    attributes = match.group(1)

    type_match = re.search(
        r"\btype\s*=\s*(['\"])(.*?)\1",
        attributes,
        flags=re.I | re.S,
    )

    if (
        not type_match
        or type_match.group(2).strip().lower()
        != "application/ld+json"
    ):
        continue

    try:
        data = json.loads(
            html.unescape(match.group(2)).strip()
        )
    except Exception:
        continue

    nodes = []

    if isinstance(data, dict):
        if isinstance(data.get("@graph"), list):
            nodes = data["@graph"]
        else:
            nodes = [data]

    faq_node = next(
        (
            node
            for node in nodes
            if isinstance(node, dict)
            and node.get("@type") == "FAQPage"
        ),
        None,
    )

    if faq_node is None:
        continue

    faq_node["mainEntity"] = faq_entities

    serialized = json.dumps(
        data,
        ensure_ascii=False,
        separators=(",", ":"),
    ).replace("</", "<\\/")

    replacement = (
        "<script"
        + attributes
        + ">"
        + serialized
        + "</script>"
    )

    source = (
        source[:match.start()]
        + replacement
        + source[match.end():]
    )

    schema_updated = True
    break

if not schema_updated:
    schema = {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "@id": "https://linkray.ru/#faq",
        "mainEntity": faq_entities,
    }

    schema_tag = (
        '\n<script id="lr-ready-faq-schema-v3" '
        'type="application/ld+json">'
        + json.dumps(
            schema,
            ensure_ascii=False,
            separators=(",", ":"),
        ).replace("</", "<\\/")
        + "</script>\n"
    )

    head_close = re.search(
        r"</head>",
        source,
        flags=re.I,
    )

    if not head_close:
        raise SystemExit(
            "Не найден закрывающий тег </head>"
        )

    source = (
        source[:head_close.start()]
        + schema_tag
        + source[head_close.start():]
    )

path.write_text(source, encoding="utf-8")

print("Оба FAQ и SEO-разметка обновлены")
PY

echo "[3/7] Проверяю результат"

python3 - <<'PY'
from pathlib import Path
import re

source = Path(
    "public/linkray-site/index.html"
).read_text(encoding="utf-8")

questions = [
    "Как войти в личный кабинет?",
    "Как подключить канал?",
    "Что показывает личный кабинет?",
    "Сайт заменяет бота?",
    "Когда становится доступен полный отчёт?",
    "Сайт работает на телефоне?",
]

for question in questions:
    count = source.count(question)

    if count < 2:
        raise SystemExit(
            f"Вопрос отсутствует в двух версиях FAQ: {question}"
        )

if source.count("<h2>Частые вопросы</h2>") < 2:
    raise SystemExit(
        "Заголовок не обновлён в двух версиях"
    )

if len(re.findall(
    r"<div\b[^>]*class\s*=\s*['\"][^'\"]*lr-m-faq-list",
    source,
    flags=re.I,
)) != 1:
    raise SystemExit(
        "Мобильный FAQ-контейнер повреждён"
    )

if len(re.findall(
    r"<div\b[^>]*class\s*=\s*['\"][^'\"]*faq-list",
    source,
    flags=re.I,
)) < 2:
    raise SystemExit(
        "FAQ-контейнеры повреждены"
    )

print("Локальная проверка FAQ пройдена")
PY

echo "[4/7] Пересобираю только приложение"

docker compose up -d --build app
sleep 15

echo "[5/7] Проверяю опубликованный FAQ"

STATUS="$(
  curl -sS \
    -o "$BACKUP/live-index.html" \
    -w '%{http_code}' \
    --max-time 20 \
    https://linkray.ru/
)"

echo "Главная: $STATUS"
[[ "$STATUS" == "200" ]]

grep -q \
  "Как войти в личный кабинет?" \
  "$BACKUP/live-index.html"

grep -q \
  "Сайт заменяет бота?" \
  "$BACKUP/live-index.html"

grep -q \
  "Сайт работает на телефоне?" \
  "$BACKUP/live-index.html"

echo "[6/7] Проверяю журнал запуска"

if docker logs --since 45s linkray-app 2>&1 |
   grep -E \
     "SyntaxError|ReferenceError|ERR_MODULE_NOT_FOUND|Cannot find module"; then
  echo "Обнаружена ошибка запуска"
  exit 1
fi

echo "[7/7] Сохраняю только FAQ"

git add -- "$INDEX"

if ! git diff --cached --quiet; then
  git commit -m \
    "Update FAQ for ready LinkRay website"
