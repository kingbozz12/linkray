#!/usr/bin/env bash
set -Eeuo pipefail

cd /opt/linkray

SRC="src/linkrayWebsiteRoutes.js"
STAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP_DIR="/opt/linkray-backups/cabinet-antifraud-live-v11-$STAMP"
mkdir -p "$BACKUP_DIR"
cp "$SRC" "$BACKUP_DIR/linkrayWebsiteRoutes.js"

rollback() {
  echo
  echo "[ОТКАТ] Возвращаю прежний website routes"
  cp "$BACKUP_DIR/linkrayWebsiteRoutes.js" "$SRC" || true
}
trap 'rollback' ERR

echo "[1/8] Проверяю текущую версию"
git status --short
grep -n "LINKRAY_CABINET_ACTIVE_ANTIFRAUD_HEALTH_V9" "$SRC" >/dev/null \
  || { echo "Не найден установленный V9. Ничего не меняю."; exit 1; }

echo "[2/8] Исправляю только расчёт AntiFraud для здоровья каналов"

python3 - <<'PY'
from pathlib import Path

path = Path("src/linkrayWebsiteRoutes.js")
s = path.read_text(encoding="utf-8")

MARKER = "LINKRAY_CABINET_ANTIFRAUD_LIVE_STATUS_V11"
if MARKER in s:
    print("V11 уже установлен.")
    raise SystemExit(0)

needle = "    const risk = lrC5Risk(antifraudConfig, events);\n"
if s.count(needle) != 1:
    raise SystemExit(
        f"Ожидалась одна точка после lrC5Risk, найдено: {s.count(needle)}. Исходник не изменён."
    )

block = r"""
    // LINKRAY_CABINET_ANTIFRAUD_LIVE_STATUS_V11
    // Для карточки здоровья учитываем только ТЕКУЩУЮ незавершённую угрозу,
    // возникшую после последнего включения AntiFraud.
    // Исторические события/старые наплывы не должны делать канал красным.
    const lrC11WaveRows = lrC5MatchingRows(
      base.keys,
      antifraudWaves,
    ).sort((a, b) => lrC5Time(b) - lrC5Time(a));

    const lrC11LatestWave = lrC11WaveRows[0] || null;
    const lrC11WaveStatus = String(
      lrC5Pick(
        lrC11LatestWave || {},
        ['status', 'state', 'resolution', 'result'],
      ) || '',
    )
      .trim()
      .toLowerCase();

    const lrC11ResolvedStatuses = new Set([
      'resolved',
      'cleared',
      'ignored',
      'closed',
      'finished',
      'completed',
      'safe',
      'normal',
      'inactive',
      'dismissed',
      'cancelled',
      'canceled',
      'очищен',
      'очищено',
      'решено',
      'закрыт',
      'закрыто',
      'проигнорирован',
      'завершён',
      'завершен',
    ]);

    const lrC11ThreatStatuses = new Set([
      'high',
      'critical',
      'danger',
      'unsafe',
      'suspicious',
      'threat',
      'высокий',
      'критический',
      'опасный',
      'угроза',
    ]);

    const lrC11Enabled = lrC5Bool(
      lrC5Pick(
        antifraudConfig,
        ['enabled', 'is_enabled', 'active', 'is_active'],
      ),
      false,
    );

    const lrC11EnabledAt = lrC5Time(
      lrC5Pick(
        antifraudConfig,
        ['learning_started_at', 'enabled_at', 'created_at'],
      ),
    );

    const lrC11WaveAt = lrC11LatestWave
      ? lrC5Time(lrC11LatestWave)
      : 0;

    const lrC11AgeMs = lrC11WaveAt
      ? Date.now() - lrC11WaveAt
      : Number.POSITIVE_INFINITY;

    const lrC11Recent =
      Number.isFinite(lrC11AgeMs) &&
      lrC11AgeMs >= -5 * 60 * 1000 &&
      lrC11AgeMs <= 24 * 60 * 60 * 1000;

    const lrC11AfterEnable =
      !lrC11EnabledAt ||
      (lrC11WaveAt && lrC11WaveAt >= lrC11EnabledAt - 60 * 1000);

    const lrC11ThreatCountFields = [
      ['eligible_count', 'eligibleCount'],
      ['probable_bot_count', 'probableBotCount'],
      ['high_confidence_bot_count', 'highConfidenceBotCount'],
      ['high_count', 'highCount'],
      ['medium_count', 'mediumCount'],
      ['suspicious_count', 'suspiciousCount'],
      ['suspected_count', 'suspectedCount'],
    ];

    const lrC11HasSuspiciousCount = lrC11ThreatCountFields.some(
      (names) => {
        const value = Number(
          lrC5Pick(lrC11LatestWave || {}, names) || 0,
        );
        return Number.isFinite(value) && value > 0;
      },
    );

    const lrC11CurrentThreat = Boolean(
      lrC11Enabled &&
      lrC11LatestWave &&
      lrC11Recent &&
      lrC11AfterEnable &&
      !lrC11ResolvedStatuses.has(lrC11WaveStatus) &&
      (
        lrC11HasSuspiciousCount ||
        lrC11ThreatStatuses.has(lrC11WaveStatus)
      )
    );
"""

s = s.replace(needle, needle + block, 1)

needle2 = "      level: risk.level,\n"
if s.count(needle2) != 1:
    raise SystemExit(
        f"Ожидалась одна строка level: risk.level, найдено: {s.count(needle2)}. Исходник не изменён."
    )
s = s.replace(
    needle2,
    "      currentThreat: lrC11CurrentThreat,\n" + needle2,
    1,
)

start = s.find("  const itemText = (item) =>")
end = s.find("  const mentionsAntifraud =", start)
if start < 0 or end < 0 or end <= start:
    raise SystemExit("Не найден блок itemText/mentionsAntifraud. Исходник не изменён.")

new_item_text = r"""  const itemText = (item) => {
    const parts = [];

    const visit = (value) => {
      if (Array.isArray(value)) {
        value.forEach(visit);
        return;
      }

      if (value && typeof value === 'object') {
        Object.values(value).forEach(visit);
        return;
      }

      if (
        typeof value === 'string' ||
        typeof value === 'number' ||
        typeof value === 'boolean'
      ) {
        parts.push(text(value));
      }
    };

    visit(item);
    return parts.join(' ');
  };

"""
s = s[:start] + new_item_text + s[end:]

old = r"""    const enabled = antifraudEnabled(channel);

    if (enabled === false) return false;

    const wave = latestWave(channel);
"""
new = r"""    const enabled = antifraudEnabled(channel);

    if (enabled === false) return false;

    const antifraud = antifraudObject(channel);
    const explicitThreat = first(
      antifraud?.currentThreat,
      antifraud?.current_threat,
    );

    if (explicitThreat !== undefined) {
      return truthy(explicitThreat);
    }

    const wave = latestWave(channel);
"""
if old not in s:
    raise SystemExit("Не найдена точка currentThreat внутри waveIsCurrentThreat. Исходник не изменён.")
s = s.replace(old, new, 1)

needle3 = "      status: 'Работает',\n"
pos = s.find(needle3, s.find("function lrC6ActiveAntifraudHealth(payload)"))
if pos < 0:
    raise SystemExit("Не найден healthy-return V9. Исходник не изменён.")

insert_at = pos + len(needle3)
s = s[:insert_at] + (
    "      issues: [healthyMessage],\n"
    "      antifraudLevel: 'safe',\n"
) + s[insert_at:]

path.write_text(s, encoding="utf-8")
print("V11 установлен в src/linkrayWebsiteRoutes.js")
PY

echo "[3/8] Проверяю синтаксис JavaScript"
node --check "$SRC"

echo "[4/8] Проверяю, что затронут только сайт"
git diff -- "$SRC" | sed -n '1,260p'
echo
echo "Другие файлы:"
git status --short

echo "[5/8] Пересобираю только приложение"
docker compose up -d --build linkray-app

echo "[6/8] Проверяю запуск"
sleep 3
docker ps --format '{{.Names}} {{.Status}}' | grep '^linkray-app '
curl -fsS -o /dev/null -w 'Главная: %{http_code}\n' https://linkray.ru/
curl -fsS -o /dev/null -w 'Кабинет: %{http_code}\n' https://linkray.ru/cabinet

echo "[7/8] Проверяю ошибки запуска"
docker logs --since 2m linkray-app 2>&1 \
  | grep -Ei "SyntaxError|ReferenceError|TypeError|Cannot find|Unhandled|FATAL" \
  | tail -80 || true

echo "[8/8] Сохраняю изолированное исправление"
git add "$SRC"
if git diff --cached --quiet; then
  echo "Изменений для commit нет."
else
  git commit -m "Fix cabinet AntiFraud live health status"
  git push origin main
fi

trap - ERR

echo
echo "============================================================"
echo "V11 ГОТОВ"
echo "Исправлено только отображение текущего AntiFraud в веб-кабинете:"
echo "• история больше не делает канал красным;"
echo "• учитывается только свежая незавершённая угроза после включения защиты;"
echo "• обычные +подписки при 0 подозрительных не считаются проблемой;"
echo "• issues[] теперь корректно распознаётся и очищается от старого ложного статуса."
echo
echo "НЕ МЕНЯЛИСЬ:"
echo "• Studio"
echo "• автопостинг"
echo "• добавление/удаление каналов"
echo "• логика AntiFraud в MAX"
echo "• база данных"
echo
echo "Резервная копия: $BACKUP_DIR"
echo "============================================================"
