from pathlib import Path
import re

path = Path("public/linkray-site/cabinet-stable.js")
source = path.read_text(encoding="utf-8")

START = "/* LINKRAY_CABINET_REAL_SETTINGS_FRONT_V5_START */"
END = "/* LINKRAY_CABINET_REAL_SETTINGS_FRONT_V5_END */"

source = re.sub(
    rf"\n?{re.escape(START)}[\s\S]*?{re.escape(END)}\s*\n?",
    "\n",
    source,
    count=1,
)

old_card = '<article class="channel-card">'
new_card = (
    '<article class="channel-card" '
    'data-channel-id="${escapeHtml(channel.id)}">'
)

if old_card in source:
    if source.count(old_card) != 1:
        raise SystemExit(
            "Найдено несколько шаблонов channel-card без ID."
        )
    source = source.replace(old_card, new_card, 1)
elif 'class="channel-card" data-channel-id=' not in source:
