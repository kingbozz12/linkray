    r"""(?ms)^[ \t]*app\.get\(\s*
        \[\s*['"]/cabinet['"]\s*,\s*
        ['"]/cabinet/['"]\s*,?\s*\]\s*,""",
    re.VERBOSE,
)

route_matches = list(route_pattern.finditer(source))

if len(route_matches) != 1:
    fallback_pattern = re.compile(
        r"""(?ms)^[ \t]*app\.get\(\s*
            \[\s*['"]/cabinet['"]\s*,\s*
            ['"]/cabinet/['"]\s*,?\s*\]""",
        re.VERBOSE,
    )
