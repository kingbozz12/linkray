from pathlib import Path
import re

path = Path("src/linkrayWebsiteRoutes.js")
source = path.read_text(encoding="utf-8")

START = "// LINKRAY_CABINET_REAL_SETTINGS_V5_START"
END = "// LINKRAY_CABINET_REAL_SETTINGS_V5_END"

source = re.sub(
