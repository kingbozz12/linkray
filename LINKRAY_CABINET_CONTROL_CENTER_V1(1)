from pathlib import Path
import re
import sys

js_name = Path(sys.argv[1]).name
css_name = Path(sys.argv[2]).name
version = "20260807-cabinet-center-v1"

changed = 0

for path in Path("public").rglob("*.html"):
    try:
        text = path.read_text(encoding="utf-8")
    except Exception:
        continue

    original = text

    text = re.sub(
        rf'({re.escape(js_name)})(?:\?[^"\']*)?',
        rf'\1?v={version}',
        text,
    )

    text = re.sub(
        rf'({re.escape(css_name)})(?:\?[^"\']*)?',
        rf'\1?v={version}',
        text,
    )

    if text != original:
        path.write_text(text, encoding="utf-8")
        changed += 1

print("HTML-файлов обновлено:", changed)
