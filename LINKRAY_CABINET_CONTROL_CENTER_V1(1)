#!/usr/bin/env bash
set -Eeuo pipefail

cd /opt/linkray

BACKUP="$(mktemp -d /tmp/linkray-cabinet-center-v1.XXXXXX)"
DONE=0

restore_files() {
  echo
  echo "[ОТКАТ] Возвращаю прежний личный кабинет"

  if [[ -f "$BACKUP/frontend.js" && -n "${FRONTEND_JS:-}" ]]; then
    cp -f "$BACKUP/frontend.js" "$FRONTEND_JS"
  fi

  if [[ -f "$BACKUP/frontend.css" && -n "${FRONTEND_CSS:-}" ]]; then
    cp -f "$BACKUP/frontend.css" "$FRONTEND_CSS"
  fi

  if [[ -d "$BACKUP/html" ]]; then
    while IFS= read -r file; do
      rel="${file#"$BACKUP/html/"}"
      mkdir -p "$(dirname "$rel")"
      cp -f "$file" "$rel"
    done < <(find "$BACKUP/html" -type f)
  fi

  docker compose up -d --build app >/dev/null 2>&1 || true
  echo "[ОТКАТ] Предыдущая версия восстановлена"
}

on_error() {
  code=$?

  if [[ "$DONE" != "1" ]]; then
    restore_files
  fi

  exit "$code"
}

trap on_error ERR

echo "[1/9] Нахожу фактические файлы личного кабинета"

mapfile -t DETECTED < <(
  python3 - <<'PY'
from pathlib import Path

root = Path("public")
markers = (
    "Загружаем LinkRay",
    "Studio в MAX",
    "Последние публикации",
    "Личный кабинет",
    "/api/website/",
    "/cabinet",
)

candidates = []

for path in root.rglob("*.js"):
    if any(part in {"node_modules", ".git"} for part in path.parts):
        continue

    try:
        text = path.read_text(encoding="utf-8")
    except Exception:
        continue

    score = sum(text.count(marker) for marker in markers)

    if score:
        candidates.append((score, len(text), path))

if not candidates:
    raise SystemExit(
        "Не найден JavaScript личного кабинета"
    )

candidates.sort(
    key=lambda item: (
        item[0],
        item[1],
    ),
    reverse=True,
)

js_path = candidates[0][2]
directory = js_path.parent

css_candidates = []

for path in directory.glob("*.css"):
    try:
        text = path.read_text(encoding="utf-8")
    except Exception:
        continue

    score = sum(text.count(marker) for marker in markers)
    score += 3 if path.name == "styles.css" else 0
    css_candidates.append((score, len(text), path))

if not css_candidates:
    fallback = Path("public/linkray-site/styles.css")

    if fallback.exists():
        css_path = fallback
    else:
        raise SystemExit(
            "Не найден CSS личного кабинета"
        )
else:
    css_candidates.sort(
        key=lambda item: (
            item[0],
            item[1],
        ),
        reverse=True,
    )
    css_path = css_candidates[0][2]

print(js_path)
print(css_path)
PY
)

FRONTEND_JS="${DETECTED[0]}"
FRONTEND_CSS="${DETECTED[1]}"

echo "JavaScript: $FRONTEND_JS"
echo "CSS: $FRONTEND_CSS"

test -f "$FRONTEND_JS"
test -f "$FRONTEND_CSS"

cp -f "$FRONTEND_JS" "$BACKUP/frontend.js"
cp -f "$FRONTEND_CSS" "$BACKUP/frontend.css"

mkdir -p "$BACKUP/html"

while IFS= read -r html; do
  mkdir -p "$BACKUP/html/$(dirname "$html")"
  cp -f "$html" "$BACKUP/html/$html"
done < <(
  find public -type f -name '*.html' \
    -not -path '*/node_modules/*'
)

echo "[2/9] Добавляю центр уведомлений и состояние каналов"

python3 - "$FRONTEND_JS" "$FRONTEND_CSS" <<'PY'
from pathlib import Path
import re
import sys

js_path = Path(sys.argv[1])
css_path = Path(sys.argv[2])

js = js_path.read_text(encoding="utf-8")
css = css_path.read_text(encoding="utf-8")

JS_START = "/* LR_CABINET_CONTROL_CENTER_V1_START */"
JS_END = "/* LR_CABINET_CONTROL_CENTER_V1_END */"
CSS_START = "/* LR_CABINET_CONTROL_CENTER_V1_STYLES_START */"
CSS_END = "/* LR_CABINET_CONTROL_CENTER_V1_STYLES_END */"

js = re.sub(
    rf"\s*{re.escape(JS_START)}[\s\S]*?{re.escape(JS_END)}\s*",
    "\n",
    js,
)

css = re.sub(
    rf"\s*{re.escape(CSS_START)}[\s\S]*?{re.escape(CSS_END)}\s*",
    "\n",
    css,
)

js_patch = r'''
/* LR_CABINET_CONTROL_CENTER_V1_START */
(() => {
  'use strict';

  const VERSION = 'lr-cabinet-control-center-v1';
  const STORAGE_KEY = 'linkray:cabinet:notifications:v1';
  const BOT_URL = '/go-bot';
  let updateTimer = null;

  const clean = (value) =>
    String(value || '')
      .replace(/\s+/g, ' ')
      .trim();

  const textOf = (element) =>
    clean(element?.textContent || '');

  const cabinetVisible = () => {
    const path = String(location.pathname || '').toLowerCase();
    const text = textOf(document.body);

    return (
      path.includes('/cabinet') ||
      (
        /личный кабинет/i.test(text) &&
        /обзор/i.test(text) &&
        /каналы/i.test(text)
      )
    );
  };

  const isLoading = () => {
    const text = textOf(document.body);

    return (
      /загружаем linkray/i.test(text) &&
      !/подписчики|antifraud|последние публикации/i.test(text)
    );
  };

  const findByText = (
    pattern,
    selector = 'button, a, [role="button"]',
  ) =>
    Array.from(document.querySelectorAll(selector))
      .find((element) => pattern.test(textOf(element)));

  const clickByText = (pattern) => {
    const element = findByText(pattern);

    if (!element) return false;

    element.click();
    return true;
  };

  const visible = (element) => {
    if (!element) return false;

    const style = getComputedStyle(element);
    const rect = element.getBoundingClientRect();

    return (
      style.display !== 'none' &&
      style.visibility !== 'hidden' &&
      rect.width > 0 &&
      rect.height > 0
    );
  };

  const readState = () => {
    try {
      const value = JSON.parse(
        localStorage.getItem(STORAGE_KEY) || '{}',
      );

      return value && typeof value === 'object'
        ? value
        : {};
    } catch {
      return {};
    }
  };

  const writeState = (value) => {
    try {
      localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify(value),
      );
    } catch {}
  };

  const fingerprint = (items) =>
    items
      .map((item) => `${item.level}:${item.text}`)
      .sort()
      .join('|');

  const inferChannelCards = () => {
    const candidates = Array.from(
      document.querySelectorAll(
        'main article, main section, main [class*="card"], ' +
        '[class*="cabinet"] article, [class*="channel"]',
      ),
    );

    const cards = [];
    const seen = new Set();

    for (const element of candidates) {
      if (!visible(element)) continue;

      const text = textOf(element);

      if (
        text.length < 80 ||
        text.length > 8000 ||
        !/подписчик|просмотр|antifraud|последние публикации/i
          .test(text)
      ) {
        continue;
      }

      if (
        !/доступ бота|скачать csv|открыть канал|аналитика канала|подписки за 24/i
          .test(text)
      ) {
        continue;
      }

      if (
        cards.some((card) => card.contains(element))
      ) {
        continue;
      }

      if (
        cards.some((card) => element.contains(card))
      ) {
        continue;
      }

      const key = text.slice(0, 220);

      if (seen.has(key)) continue;

      seen.add(key);
      cards.push(element);
    }

    return cards;
  };

  const channelTitle = (card, index) => {
    const headings = Array.from(
      card.querySelectorAll('h1, h2, h3, h4, strong'),
    )
      .map(textOf)
      .filter(Boolean)
      .filter((text) =>
        !/подписчик|просмотр|antifraud|последние публикации|обновлено/i
          .test(text),
      );

    return headings[0] || `Канал ${index + 1}`;
  };

  const cardStatus = (card) => {
    const text = textOf(card);

    const bot = /доступ бота\s*(есть|доступен|активен)/i.test(text)
      ? 'ok'
      : /нет доступа|доступ бота\s*(нет|отсутствует)/i.test(text)
        ? 'error'
        : 'unknown';

    const analytics =
      /аналитика канала отключена|аналитика отключена/i.test(text)
        ? 'off'
        : /аналитика собирается|накоплени[ея] данных|готов через/i
          .test(text)
          ? 'collecting'
          : /подписки за 24|отписки за 24|er 24|просмотры за 24/i
            .test(text)
            ? 'on'
            : 'unknown';

    const antifraud =
      /защита выключена|antifraud отключ/i.test(text)
        ? 'off'
        : /защита включена|antifraud включ/i.test(text)
          ? 'on'
          : 'unknown';

    return {
      bot,
      analytics,
      antifraud,
    };
  };

  const makeAlerts = (cards) => {
    const alerts = [];
    const pageText = textOf(document.body);

    if (/не удалось|ошибка загрузки|команда не обработана/i.test(pageText)) {
      alerts.push({
        level: 'error',
        text: 'В кабинете обнаружена ошибка загрузки или обработки данных.',
      });
    }

    cards.forEach((card, index) => {
      const title = channelTitle(card, index);
      const status = cardStatus(card);

      if (status.bot === 'error') {
        alerts.push({
          level: 'error',
          text: `${title}: у LinkRay нет доступа администратора.`,
        });
      }

      if (status.analytics === 'off') {
        alerts.push({
          level: 'warning',
          text: `${title}: аналитика отключена.`,
        });
      }

      if (status.analytics === 'collecting') {
        alerts.push({
          level: 'info',
          text: `${title}: аналитика накапливает данные.`,
        });
      }

      if (status.antifraud === 'off') {
        alerts.push({
          level: 'warning',
          text: `${title}: защита AntiFraud выключена.`,
        });
      }

      if (/нет публикаций|публикаций пока нет/i.test(textOf(card))) {
        alerts.push({
          level: 'info',
          text: `${title}: публикаций пока нет.`,
        });
      }
    });

    if (!cards.length) {
      alerts.push({
        level: 'info',
        text: 'Карточки каналов ещё не загружены.',
      });
    }

    return alerts.slice(0, 12);
  };

  const statusLabel = (type, value) => {
    const labels = {
      bot: {
        ok: 'Доступ бота: есть',
        error: 'Доступ бота: нет',
        unknown: 'Доступ бота: проверяется',
      },
      analytics: {
        on: 'Аналитика: включена',
        off: 'Аналитика: отключена',
        collecting: 'Аналитика: сбор данных',
        unknown: 'Аналитика: статус неизвестен',
      },
      antifraud: {
        on: 'AntiFraud: включён',
        off: 'AntiFraud: отключён',
        unknown: 'AntiFraud: статус неизвестен',
      },
    };

    return labels[type]?.[value] || value;
  };

  const addChannelSettings = (cards) => {
    cards.forEach((card, index) => {
      if (
        card.querySelector(
          ':scope > .lrcc-v1-channel-settings',
        )
      ) {
        return;
      }

      const status = cardStatus(card);
      const panel = document.createElement('section');
      panel.className = 'lrcc-v1-channel-settings';
      panel.setAttribute(
        'aria-label',
        'Состояние функций канала',
      );

      const title = document.createElement('div');
      title.className = 'lrcc-v1-channel-settings-head';
      title.innerHTML =
        '<strong>Управление каналом</strong>' +
        '<span>Состояние функций</span>';

      const chips = document.createElement('div');
      chips.className = 'lrcc-v1-status-grid';

      [
        ['bot', status.bot],
        ['analytics', status.analytics],
        ['antifraud', status.antifraud],
      ].forEach(([type, value]) => {
        const chip = document.createElement('span');
        chip.className =
          `lrcc-v1-status lrcc-v1-status-${value}`;
        chip.textContent = statusLabel(type, value);
        chips.appendChild(chip);
      });

      const actions = document.createElement('div');
      actions.className = 'lrcc-v1-channel-actions';

      const maxButton = document.createElement('a');
      maxButton.className =
        'lrcc-v1-action lrcc-v1-action-primary';
      maxButton.href = BOT_URL;
      maxButton.textContent = 'Настроить в MAX';

      const refreshButton = document.createElement('button');
      refreshButton.className = 'lrcc-v1-action';
      refreshButton.type = 'button';
      refreshButton.textContent = 'Обновить';
      refreshButton.addEventListener('click', () => {
        const existing = Array.from(
          card.querySelectorAll('button, a'),
        ).find((element) =>
          /обновить|проверить доступ/i.test(textOf(element)),
        );

        if (existing) {
          existing.click();
        } else {
          location.reload();
        }
      });

      actions.append(maxButton, refreshButton);
      panel.append(title, chips, actions);
      card.appendChild(panel);

      card.dataset.lrccChannel = String(index + 1);
    });
  };

  const findInsertRoot = () => {
    const activeOverview = Array.from(
      document.querySelectorAll(
        'button, a, [role="button"]',
      ),
    ).find((element) =>
      /обзор/i.test(textOf(element)) &&
      (
        element.classList.contains('active') ||
        element.getAttribute('aria-current') === 'page' ||
        element.getAttribute('aria-selected') === 'true'
      ),
    );

    const roots = Array.from(
      document.querySelectorAll(
        'main, [class*="cabinet-content"], ' +
        '[class*="dashboard-content"], [class*="page-content"]',
      ),
    ).filter(visible);

    const root = roots[0] || document.body;

    if (!activeOverview) {
      const pageText = textOf(root);

      if (
        /последние публикации|antifraud/i.test(pageText) &&
        !/обзор канала|общая сводка/i.test(pageText)
      ) {
        return null;
      }
    }

    return root;
  };

  const escapeHtml = (value) =>
    String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');

  const renderCenter = (cards, alerts) => {
    const root = findInsertRoot();

    if (!root) return;

    let center = document.getElementById(
      'lrcc-v1-control-center',
    );

    if (!center) {
      center = document.createElement('section');
      center.id = 'lrcc-v1-control-center';
      center.className = 'lrcc-v1-center';

      const firstMeaningful = Array.from(root.children)
        .find((element) => visible(element));

      if (firstMeaningful) {
        root.insertBefore(center, firstMeaningful);
      } else {
        root.prepend(center);
      }
    }

    const state = readState();
    const currentFingerprint = fingerprint(alerts);
    const isRead =
      state.fingerprint === currentFingerprint &&
      state.read === true;

    const unreadCount = isRead
      ? 0
      : alerts.filter((item) => item.level !== 'info').length;

    const warnings = alerts.filter((item) =>
      item.level === 'error' ||
      item.level === 'warning'
    ).length;

    const stateText = alerts.some(
      (item) => item.level === 'error',
    )
      ? 'Есть ошибки'
      : alerts.some((item) => item.level === 'warning')
        ? 'Есть замечания'
        : 'Всё спокойно';

    const alertsHtml = alerts.length
      ? alerts.map((item) => `
          <div class="lrcc-v1-notification lrcc-v1-notification-${item.level}">
            <span aria-hidden="true"></span>
            <p>${escapeHtml(item.text)}</p>
          </div>
        `).join('')
      : `
          <div class="lrcc-v1-notification lrcc-v1-notification-ok">
            <span aria-hidden="true"></span>
            <p>Критичных событий нет.</p>
          </div>
        `;

    center.innerHTML = `
      <div class="lrcc-v1-center-head">
        <div>
          <span class="lrcc-v1-kicker">Личный кабинет</span>
          <h2>Центр управления</h2>
          <p>Доступы, аналитика и защита подключённых каналов.</p>
        </div>
        <span class="lrcc-v1-counter${
          unreadCount ? ' has-alerts' : ''
        }">${unreadCount || '✓'}</span>
      </div>

      <div class="lrcc-v1-summary">
        <article>
          <span>Каналы</span>
          <strong>${cards.length}</strong>
        </article>
        <article>
          <span>Требует внимания</span>
          <strong>${warnings}</strong>
        </article>
        <article>
          <span>Состояние</span>
          <strong>${stateText}</strong>
        </article>
      </div>

      <div class="lrcc-v1-notifications">
        <div class="lrcc-v1-notifications-head">
          <div>
            <strong>Уведомления</strong>
            <span>Сводка по текущему состоянию</span>
          </div>
          <button type="button" data-lrcc-read>
            ${isRead ? 'Прочитано' : 'Отметить прочитанным'}
          </button>
        </div>

        <div class="lrcc-v1-notification-list">
          ${alertsHtml}
        </div>
      </div>

      <div class="lrcc-v1-quick-actions">
        <button type="button" data-lrcc-channels>Каналы</button>
        <button type="button" data-lrcc-refresh>Обновить данные</button>
        <a href="${BOT_URL}">Studio в MAX</a>
      </div>
    `;

    center
      .querySelector('[data-lrcc-read]')
      ?.addEventListener('click', () => {
        writeState({
          fingerprint: currentFingerprint,
          read: true,
          readAt: Date.now(),
        });
        scheduleUpdate();
      });

    center
      .querySelector('[data-lrcc-channels]')
      ?.addEventListener('click', () => {
        if (!clickByText(/^каналы$/i)) {
          location.hash = 'channels';
        }
      });

    center
      .querySelector('[data-lrcc-refresh]')
      ?.addEventListener('click', () => {
        const refresh = findByText(
          /обновить|проверить доступ/i,
        );

        if (refresh) {
          refresh.click();
        } else {
          location.reload();
        }
      });
  };

  const update = () => {
    if (!cabinetVisible() || isLoading()) return;

    const cards = inferChannelCards();
    const alerts = makeAlerts(cards);

    addChannelSettings(cards);
    renderCenter(cards, alerts);

    document.documentElement.dataset.lrccVersion = VERSION;
  };

  function scheduleUpdate() {
    window.clearTimeout(updateTimer);
    updateTimer = window.setTimeout(update, 120);
  }

  const start = () => {
    if (!cabinetVisible()) return;

    scheduleUpdate();

    const observer = new MutationObserver(scheduleUpdate);
    observer.observe(document.body, {
      childList: true,
      subtree: true,
      characterData: true,
    });

    window.addEventListener('popstate', scheduleUpdate);
    window.addEventListener('hashchange', scheduleUpdate);
    window.addEventListener('focus', scheduleUpdate);
    window.setInterval(scheduleUpdate, 15000);
  };

  if (document.readyState === 'loading') {
    document.addEventListener(
      'DOMContentLoaded',
      start,
      { once: true },
    );
  } else {
    start();
  }
})();
/* LR_CABINET_CONTROL_CENTER_V1_END */
'''

