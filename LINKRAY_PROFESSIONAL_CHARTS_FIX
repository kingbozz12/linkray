  padding: 14px;
  overflow: hidden;
}

.lr-professional-chart {
  width: 100%;
}

.lr-chart-summary {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  margin-bottom: 7px;
}

.lr-chart-summary > div {
  min-width: 0;
  border: 1px solid rgba(255,255,255,.065);
  border-radius: 12px;
  padding: 9px 10px;
  background: rgba(255,255,255,.022);
}

.lr-chart-summary span {
  display: block;
  margin-bottom: 3px;
  color: var(--muted);
  font-size: 9px;
}

.lr-chart-summary strong {
  display: block;
  overflow: hidden;
  font-size: 15px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lr-chart-svg {
  width: 100%;
  height: auto;
  display: block;
  overflow: visible;
  touch-action: manipulation;
}

.lr-chart-grid-line {
  stroke: rgba(144, 170, 188, .12);
  stroke-width: 1;
  vector-effect: non-scaling-stroke;
}

.lr-chart-y-label,
.lr-chart-x-label {
  fill: #7f96a8;
  font-size: 9px;
  font-weight: 600;
}

.lr-chart-area {
  pointer-events: none;
}

.lr-chart-line-subscribers,
.lr-chart-line-views {
  fill: none;
  stroke-width: 3;
  stroke-linecap: round;
  stroke-linejoin: round;
  vector-effect: non-scaling-stroke;
  filter: drop-shadow(0 2px 4px rgba(0,0,0,.22));
}

.lr-chart-line-subscribers {
  stroke: #59dda0;
}

.lr-chart-line-views {
  stroke: #73b7ff;
}

.lr-chart-point {
  fill: #071b28;
  stroke: #9fb2c0;
  stroke-width: 2;
  vector-effect: non-scaling-stroke;
}

.lr-chart-point.is-last {
  fill: #f4fbf8;
  stroke: #59dda0;
  stroke-width: 2.5;
}

.lr-chart-last-halo {
  fill: rgba(89,221,160,.16);
  stroke: none;
  animation: lrChartPulse 2.4s ease-in-out infinite;
}

@keyframes lrChartPulse {
  0%, 100% {
    opacity: .55;
  }
  50% {
    opacity: 1;
  }
}

.lr-chart-empty {
  min-height: 156px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  color: var(--muted);
  text-align: center;
}

.lr-chart-empty-icon {
  color: rgba(141,163,181,.55);
  font-size: 34px;
  line-height: 1;
}

.lr-chart-empty strong {
  color: #dbe7ed;
  font-size: 13px;
}

.lr-chart-empty small {
  max-width: 280px;
  line-height: 1.45;
}

@media (max-width: 380px) {
  .lr-chart-summary {
    grid-template-columns: 1fr;
  }

  .lr-chart-y-label,
  .lr-chart-x-label {
    font-size: 8px;
  }
}
/* LINKRAY_PROFESSIONAL_CHARTS_V1_END */
'''

css = css.rstrip() + "\n\n" + css_block.strip() + "\n"

version = "20260806-professional-charts-v1"

html = re.sub(
    r'cabinet-stable\.js(?:\?v=[^"\']*)?',
    f'cabinet-stable.js?v={version}',
    html,
)
html = re.sub(
    r'cabinet-stable\.css(?:\?v=[^"\']*)?',
    f'cabinet-stable.css?v={version}',
    html,
)

js_path.write_text(js, encoding="utf-8")
css_path.write_text(css, encoding="utf-8")
html_path.write_text(html, encoding="utf-8")

print("Профессиональные графики установлены")
PY

echo "[3/8] Проверяю JavaScript"

node --check "$JS"

grep -q "LINKRAY_PROFESSIONAL_CHARTS_V1" "$JS"
grep -q "professionalChart" "$JS"
grep -q "LINKRAY_PROFESSIONAL_CHARTS_V1_START" "$CSS"

echo "[4/8] Пересобираю приложение"

docker compose up -d --build app
sleep 15

echo "[5/8] Проверяю страницу и ресурсы"

CABINET_HTML="$(curl -fsS --max-time 20 https://linkray.ru/cabinet)"
printf '%s' "$CABINET_HTML" |
  grep -q "cabinet-stable.js?v=$VERSION"

echo "Кабинет: 200"
echo "JavaScript: $(curl -fsS -o /dev/null -w '%{http_code}' "https://linkray.ru/linkray-site/cabinet-stable.js?v=$VERSION")"
echo "CSS: $(curl -fsS -o /dev/null -w '%{http_code}' "https://linkray.ru/linkray-site/cabinet-stable.css?v=$VERSION")"

echo "[6/8] Проверяю запуск контейнера"

if docker logs --since 45s linkray-app 2>&1 |
   grep -E "SyntaxError|ReferenceError|ERR_MODULE_NOT_FOUND|Cannot find module"; then
  echo "Обнаружена ошибка запуска"
  exit 1
fi

echo "[7/8] Сохраняю проверенную правку"

git add -- "$JS" "$CSS" "$HTML"

if ! git diff --cached --quiet; then
  git commit -m "Improve analytics charts in LinkRay web cabinet"
  git push origin HEAD:main
else
  echo "Правка уже сохранена"
fi

DONE=1
trap - ERR
rm -rf "$BACKUP"

echo "[8/8] Готово"
echo
echo "============================================================"
echo "ГРАФИКИ ЛИЧНОГО КАБИНЕТА ПЕРЕРАБОТАНЫ"
echo
echo "• спокойный и честный масштаб без ложного резкого обвала"
echo "• шкала значений и горизонтальная сетка"
echo "• даты и время на нижней оси"
echo "• точки наблюдений и выделение последнего значения"
echo "• текущее значение и изменение за выбранный период"
echo "• сортировка по времени и удаление дублей"
echo "• аккуратная заливка под линией"
echo "============================================================"
