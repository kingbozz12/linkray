    [[
      lrV47Btn(
        '⬅️ В меню',
        'main:menu',
      ),
    ]],
    'html',
  );
}'''

is_add_function = r'''async function lrV47IsAddMode(update) {
  return Boolean(
    await lrV82ResolveAddWait(update),
  );
}'''

notify_function = r'''async function lrV47NotifyConnected(
  chatId,
  key,
  channel,
  waitState = {},
) {
  return lrV82NotifyConnected(
    chatId,
    key,
    channel,
    waitState,
  );
}'''

handle_function = r'''async function lrV47HandleAddForward(update) {
  const waitState =
    await lrV82ResolveAddWait(update);

  if (!waitState) return false;

  const chatId =
    waitState.privateChatId;

  const key =
    waitState.key ||
    waitState.eventKey ||
    chatId;

  const baseline =
    Number(waitState.baselineId || 0);

  console.log(
    '[channel add v82] forwarded post intercepted',
    JSON.stringify({
      chatId,
      userId: waitState.userId,
      key,
      eventKey: waitState.eventKey,
      baseline,
    }),
  );

  let result = false;

  try {
    if (
      typeof maybeRegisterChannel === 'function'
    ) {
      result =
        await maybeRegisterChannel(update);
    }
  } catch (error) {
    console.error(
      '[channel add v82] maybeRegisterChannel failed',
      error?.stack || error?.message || error,
    );
  }

  let channel =
    await lrV47LatestChannelAfter(
      baseline,
    );

  if (!channel && result === true) {
    channel =
      await lrV47LatestChannelAfter(0);
  }

  if (channel) {
    const notified =
      await lrV47NotifyConnected(
        chatId,
        key,
        channel,
        waitState,
      );

    if (notified) {
      await lrV47ClearSession(key);

      if (
        waitState.eventKey &&
        waitState.eventKey !== key
      ) {
        await lrV47ClearSession(
          waitState.eventKey,
        );
      }

      await lrV47StateDelLike([
        `lr_v47_add_wait:${key}`,
        waitState.eventKey
          ? `lr_v47_add_wait:${waitState.eventKey}`
          : '',
        'lr_v47_add_wait_global',
      ].filter(Boolean));
    }

    /*
     * Пересылку не передаём в Studio:
     * канал уже зарегистрирован.
     */
    return true;
  }

  const failureText =
    `❌ <b>Бот не является администратором канала</b>

Сначала добавьте LinkRay в администраторы канала и выдайте право публикации.

Канал не добавлен в базу.`;

  const rows = [[
    lrV47Btn(
      '⬅️ Главное меню',
      'main:menu',
    ),
  ]];

  let failureSent = false;

  if (
    waitState.userId &&
    typeof lrV37ApiPostMessage === 'function'
  ) {
    try {
      const response =
        await lrV37ApiPostMessage(
          { user_id: waitState.userId },
          failureText,
          rows,
        );

      failureSent =
        Boolean(response?.ok);
    } catch {}
  }

  if (!failureSent && chatId) {
    await lrV47Msg(
      chatId,
      failureText,
      rows,
      'html',
    );
  }

  return true;
}'''

def replace_function(source, name, replacement, next_name):
    pattern = re.compile(
        rf"async function {re.escape(name)}\s*\([^)]*\)\s*\{{"
        rf"[\s\S]*?"
        rf"(?=async function {re.escape(next_name)}\s*\()",
    )

    updated, count = pattern.subn(
        lambda _match: replacement + "\n",
        source,
        count=1,
    )

    if count != 1:
        raise SystemExit(
            f"Не удалось заменить функцию {name}: найдено {count}"
        )

    return updated

anchor = source.find(
    "async function lrV47ShowAddChannel"
)

if anchor < 0:
    raise SystemExit(
        "Не найдена lrV47ShowAddChannel"
    )

source = (
    source[:anchor]
    + helper
    + "\n"
    + source[anchor:]
)

source = replace_function(
    source,
    "lrV47ShowAddChannel",
    show_function,
    "lrV47IsAddMode",
)

source = replace_function(
    source,
    "lrV47IsAddMode",
    is_add_function,
    "lrV47LatestChannelAfter",
)

source = replace_function(
    source,
    "lrV47NotifyConnected",
    notify_function,
    "lrV47HandleAddForward",
)

source = replace_function(
    source,
    "lrV47HandleAddForward",
    handle_function,
    "lrV47HandleMainForward",
)

# Если ранее устанавливался V78, сохраняем его исправление удаления,
# но не позволяем ему снова заменить уведомление подключения.
v78_notify_pattern = re.compile(
    r"lrV47NotifyConnected\s*=\s*"
    r"async function lrV78NotifyConnected"
    r"\s*\([^)]*\)\s*\{[\s\S]*?\n\s*\};",
)

source, v78_count = v78_notify_pattern.subn(
    "lrV47NotifyConnected = lrV82NotifyConnected;",
    source,
    count=1,
)

marker = (
    "console.log(\n"
    "  '[channel add v82] installed: global wait, saved chat and user confirmation',\n"
    ");\n"
)

ensure_position = source.rfind(
    "await ensureDb();"
)

if ensure_position < 0:
    raise SystemExit(
        "Не найден запуск ensureDb"
    )

source = (
    source[:ensure_position]
    + marker
    + "\n"
    + source[ensure_position:]
)

path.write_text(
    source,
    encoding="utf-8",
)

checks = [
    "LR_CHANNEL_ADD_STATE_V82_START",
    "lrV82ResolveAddWait",
    "lrV82NotifyConnected",
    "[channel add v82] forwarded post intercepted",
    "[channel add v82] confirmation delivered",
]

for check in checks:
    if check not in source:
        raise SystemExit(
            f"Не установлен элемент: {check}"
        )

print(
    "Основные функции добавления заменены",
)
print(
    "Переопределение V78 исправлено:",
    bool(v78_count),
)
PY

