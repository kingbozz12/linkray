                END,
                updated_at=NOW()
              WHERE channel_id=$1::bigint
            `,
            [membership.internalId, enabled],
          );
        }

        res.setHeader('Cache-Control', 'private, no-store');

        return res.json({
          ok: true,
          channelId: membership.internalId,
          setting,
          enabled,
