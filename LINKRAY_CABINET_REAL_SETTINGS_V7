#!/usr/bin/env bash
set -Eeuo pipefail

cd /opt/linkray

SERVER="src/linkrayWebsiteRoutes.js"
FRONT="public/linkray-site/cabinet-stable.js"
CSS="public/linkray-site/cabinet-stable.css"
HTML="public/linkray-site/cabinet-stable.html"
VERSION="20260807-real-settings-v7"
START_COMMIT="$(git rev-parse HEAD)"
BACKUP="/opt/linkray-backups/cabinet-real-settings-v7-$(date +%Y%m%d-%H%M%S)"
COMMITTED=0

mkdir -p "$BACKUP"

rollback() {
  local code=$?
  trap - ERR

  echo
  echo "[ОТКАТ] Ошибка на шаге установки. Возвращаю прежний кабинет."

  for file in "$SERVER" "$FRONT" "$CSS" "$HTML"; do
    if [[ -f "$BACKUP/$file" ]]; then
      mkdir -p "$(dirname "$file")"
      cp -f "$BACKUP/$file" "$file"
    fi
  done

  if [[ "$COMMITTED" == "1" ]]; then
    git reset --hard "$START_COMMIT" >/dev/null 2>&1 || true
  fi

  docker compose up -d --build app >/dev/null 2>&1 || true

  echo "[ОТКАТ] Предыдущая версия восстановлена."
  exit "$code"
}
trap rollback ERR

echo "[1/10] Проверяю репозиторий"

if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
  echo "Остановка: в репозитории есть незавершённые изменения."
  git status --short
  exit 1
fi

git pull --ff-only

for file in "$SERVER" "$FRONT" "$CSS" "$HTML"; do
  [[ -f "$file" ]] || {
    echo "Не найден обязательный файл: $file"
    exit 1
  }
  mkdir -p "$BACKUP/$(dirname "$file")"
  cp -a "$file" "$BACKUP/$file"
done

echo "[2/10] Проверяю реальные таблицы без изменения базы"

DB_CHECK="$(
docker exec -i linkray-postgres sh -lc '
  psql -At -v ON_ERROR_STOP=1 \
    -U "${POSTGRES_USER:-linkray}" \
    -d "${POSTGRES_DB:-linkray}"
' <<'SQL'
SELECT
  CASE WHEN to_regclass('public.lr_channel_analytics_daily_channels') IS NOT NULL
       THEN 'daily_table=ok' ELSE 'daily_table=missing' END;
SELECT
  CASE WHEN to_regclass('public.lr_antifraud_channels') IS NOT NULL
       THEN 'antifraud_table=ok' ELSE 'antifraud_table=missing' END;
SELECT
  CASE WHEN (
    SELECT count(*)
    FROM information_schema.columns
    WHERE table_schema='public'
      AND table_name='lr_channel_analytics_daily_channels'
      AND column_name IN ('owner_chat_id','channel_id','enabled','updated_at')
  )=4 THEN 'daily_columns=ok' ELSE 'daily_columns=missing' END;
SELECT
  CASE WHEN (
    SELECT count(*)
    FROM information_schema.columns
    WHERE table_schema='public'
      AND table_name='lr_antifraud_channels'
      AND column_name IN (
        'channel_id','max_chat_id','title','enabled',
        'enabled_at','disabled_at','learning_started_at','updated_at'
      )
  )=8 THEN 'antifraud_columns=ok' ELSE 'antifraud_columns=missing' END;
SELECT
  CASE WHEN EXISTS (
    SELECT 1
    FROM information_schema.columns
    WHERE table_schema='public'
      AND table_name='lr_users'
      AND column_name='private_chat_id'
  ) THEN 'private_chat_id=ok' ELSE 'private_chat_id=missing' END;
SQL
)"

printf '%s\n' "$DB_CHECK"

for required in \
  "daily_table=ok" \
  "antifraud_table=ok" \
  "daily_columns=ok" \
  "antifraud_columns=ok" \
  "private_chat_id=ok"
do
  grep -qx "$required" <<<"$DB_CHECK" || {
    echo "Остановка: база не соответствует ожидаемой схеме: $required"
    exit 1
  }
done

