          .map(({ raw }) => {
            const id = lrC5Text(
              lrC5Pick(raw, ['id', 'channel_id']),
            );

            if (!/^\d+$/.test(id)) return null;

            const current = payloadById.get(id) || {};
            const title = lrC5Text(
