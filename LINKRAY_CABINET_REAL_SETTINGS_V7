        const payload = await lrC5CabinetPayload(req);
        const ownerChatId = lrV7SettingsOwnerChatId(identity);

        const memberships = (
          await lrC5LoadChannels(identity)
        ).filter(({ raw }) => lrC5ActiveChannel(raw));

