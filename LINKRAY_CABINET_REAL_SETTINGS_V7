                  enabled
                FROM public.lr_antifraud_channels
                WHERE channel_id=ANY($1::bigint[])
              `,
              [internalIds],
            )
          : [];

        const dailyById = new Map(
          dailyRows.map((row) => [
            String(row.channel_id),
