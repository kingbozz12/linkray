async function setSession(userId, state, data = {}) {
  await query(
    `
    INSERT INTO bot_sessions (user_id, state, data, updated_at)
    VALUES ($1, $2, $3::jsonb, now())
    ON CONFLICT (user_id)
    DO UPDATE SET
      state = EXCLUDED.state,
      data = EXCLUDED.data,
      updated_at = now()
    `,
    [userId, state, JSON.stringify(data)]
  );
}

async function getSession(userId) {
  const rows = await query(
    `SELECT state, data FROM bot_sessions WHERE user_id = $1`,
    [userId]
  );

  if (!rows.length) {
    return { state: 'idle', data: {} };
  }

  return {
    state: rows[0].state,
    data: rows[0].data || {},
  };
}

async function clearSession(userId) {
  await setSession(userId, 'idle', {});
}

async function getChannels() {
  return query(
    `
    SELECT id, max_chat_id, title, link, is_public
    FROM channels
    ORDER BY id DESC
    `
  );
}

async function getChannelById(channelId) {
  const rows = await query(
    `
    SELECT id, max_chat_id, title, link, is_public
    FROM channels
    WHERE id = $1
    `,
    [channelId]
  );

  return rows[0] || null;
}

async function getChannelsByIds(channelIds = []) {
  if (!channelIds.length) {
    return [];
  }

  return query(
    `
    SELECT id, max_chat_id, title, link, is_public
    FROM channels
    WHERE id = ANY($1::int[])
    ORDER BY title ASC NULLS LAST, id ASC
    `,
    [channelIds.map(Number)]
  );
}

async function refreshChannelMeta(channel) {
  try {
    const info = await getMaxChatInfo(channel.max_chat_id);

    const title =
      info?.title ||
      info?.name ||
      info?.chat?.title ||
      info?.chat?.name ||
      channel.title ||
      null;

    const link =
      info?.link ||
info?.invite_link ||
      info?.inviteLink ||
      info?.chat_link ||
      info?.chatLink ||
      info?.chat?.link ||
      null;

    const isPublic =
      info?.is_public ??
      info?.isPublic ??
      Boolean(link);

    await query(
      `
      UPDATE channels
      SET title = COALESCE($2, title),
          link = $3,
          is_public = $4
      WHERE id = $1
      `,
      [channel.id, title, link, isPublic]
    );
  } catch (error) {
    console.error('[channel refresh] failed:', channel.max_chat_id, error.message || error);
  }
}

async function refreshAllChannelsMeta() {
  const channels = await getChannels();

  for (const channel of channels) {
