async function handleMessageCallback(update) {
  const callbackId = getCallbackId(update);
  const payload = getCallbackPayload(update);
  const userId = getUserId(update);

  console.log('[callback]', JSON.stringify({ callbackId, userId, payload }));

  if (!callbackId || !userId) {
    return;
  }

  const session = await getSession(userId);

  if (payload === 'post:create') {
    await answerPostChannelSelection(callbackId, userId);
    return;
  }

  if (payload === 'post:multi') {
    await answerMultiChannelSelection(callbackId, userId, []);
    return;
  }

  if (payload === 'post:add_channel') {
    await answerAddChannelInfo(callbackId, userId);
    return;
  }

  if (payload === 'post:cancel') {
    await clearSession(userId);

    await answerCallback({
      callbackId,
      text:
`━━━━━━━━━━━━━━
❌ Действие отменено
━━━━━━━━━━━━━━`,
      attachments: postingMenuKeyboard(),
    });
    return;
  }

  if (payload === 'post:back') {
    if (session.state === 'select_channel' || session.state === 'select_channels_multi' || session.state === 'idle') {
      await clearSession(userId);

      await answerCallback({
        callbackId,
        text:
`━━━━━━━━━━━━━━
📝 **Постинг**

Создавайте отложенные посты
и публикуйте их в каналы автоматически.
━━━━━━━━━━━━━━`,
        attachments: postingMenuKeyboard(),
      });
      return;
    }

    if (session.state === 'wait_post_text') {
      await answerPostChannelSelection(callbackId, userId);
      return;
    }

    if (session.state === 'wait_publish_time') {
await answerAskPostText(callbackId, userId, session.data.channelIds || []);
      return;
    }

    if (session.state === 'confirm_post') {
      await askPublishTime(null, userId, {
        channelIds: session.data.channelIds || [],
        postText: session.data.postText,
      });

      await answerCallback({
        callbackId,
        notification: 'Вернитесь к последнему сообщению с выбором времени',
      });
      return;
    }

    await clearSession(userId);
    await answerCallback({
      callbackId,
      text:
`━━━━━━━━━━━━━━
📝 **Постинг**

Создавайте отложенные посты
и публикуйте их в каналы автоматически.
━━━━━━━━━━━━━━`,
      attachments: postingMenuKeyboard(),
    });
    return;
  }

  if (payload === 'post:all') {
    const channels = await getChannels();
    await answerAskPostText(callbackId, userId, channels.map((channel) => Number(channel.id)));
    return;
  }

  if (payload.startsWith('post:single:')) {
    const channelId = Number(payload.split(':')[2]);

    if (!channelId) {
      await answerCallback({ callbackId, notification: 'Канал не найден' });
      return;
    }

    await answerAskPostText(callbackId, userId, [channelId]);
    return;
  }

  if (payload.startsWith('post:toggle:')) {
    const channelId = Number(payload.split(':')[2]);
    const selectedChannelIds = (session.data.selectedChannelIds || []).map(Number);

    const nextSelected = selectedChannelIds.includes(channelId)
      ? selectedChannelIds.filter((id) => id !== channelId)
      : [...selectedChannelIds, channelId];

    await answerMultiChannelSelection(callbackId, userId, nextSelected);
    return;
  }

  if (payload === 'post:next') {
    const selectedChannelIds = (session.data.selectedChannelIds || []).map(Number);

    if (!selectedChannelIds.length) {
      await answerCallback({
        callbackId,
        notification: 'Выберите хотя бы один канал',
      });
      return;
    }

    await answerAskPostText(callbackId, userId, selectedChannelIds);
    return;
  }

  if (payload === 'post:confirm') {
    if (session.state !== 'confirm_post') {
      await answerCallback({
        callbackId,
        notification: 'Нет поста для подтверждения',
      });
      return;
    }

    const data = session.data;
    const channelIds = (data.channelIds || []).map(Number);

    for (const channelId of channelIds) {
      await query(
        `
        INSERT INTO scheduled_posts (
          channel_id,
          text,
          format,
          publish_at,
          notify,
          created_by_max_user_id
        )
        VALUES ($1, $2, 'markdown', $3, true, $4)
        `,
        [
          channelId,
          data.postText,
          data.publishAt,
          userId,
        ]
      );
    }

    const channels = await getChannelsByIds(channelIds);

    await clearSession(userId);

    await answerCallback({
      callbackId,
      text:
`━━━━━━━━━━━━━━
🟢 Пост запланирован

Каналы:
${channelsMarkdown(channels)}

Публикация:
\`${formatDate(new Date(data.publishAt))}\`

Создано задач: **${channelIds.length}**
━━━━━━━━━━━━━━`,
      attachments: postingMenuKeyboard(),
    });
    return;
  }

  await answerCallback({
    callbackId,
    notification: 'Команда пока не обработана',
  });
}


async function handleMessageCreated(update) {
  const chatId = getChatId(update);
  const userId = getUserId(update);
  const text = getMessageText(update);

  console.log('[message]', JSON.stringify({ chatId, userId, text }));

  if (!chatId || !userId || !text) {
    return;
  }

  const session = await getSession(userId);

  if (text === '/start' || hasCommand(text, 'Главное меню') || normalizeCommandText(text) === 'меню') {
    await clearSession(userId);
    await sendMainMenu(chatId);
    return;
  }

  if (hasCommand(text, 'Отмена')) {
    await clearSession(userId);
    await sendMaxMessage({
      chatId,
      text: 'Действие отменено.',
      attachments: postingMenuKeyboard(),
    });
    return;
  }

  if (hasCommand(text, 'Назад')) {
    await handleBack(chatId, userId, session);
    return;
  }

  const handledSession = await handleActiveSession(chatId, userId, text, session);

  if (handledSession) {
    return;
  }

  if (hasCommand(text, 'Постинг')) {
    await clearSession(userId);
    await sendPostingMenu(chatId);
return;
  }

  if (hasCommand(text, 'Мои каналы')) {
    await clearSession(userId);
    await showChannels(chatId);
    return;
  }

  if (hasCommand(text, 'Добавить канал')) {
    await clearSession(userId);
    await sendAddChannelInfo(chatId);
    return;
  }

  if (hasCommand(text, 'Создать пост')) {
    await sendChannelSelection(chatId, userId);
    return;
  }

  if (
    hasCommand(text, 'Закупы') ||
    hasCommand(text, 'Аналитика') ||
    hasCommand(text, 'Креативы') ||
    hasCommand(text, 'Антифрод') ||
    hasCommand(text, 'Отчёты') ||
    hasCommand(text, 'Профиль') ||
    hasCommand(text, 'Тарифы')
  ) {
    await sendMaxMessage({
      chatId,
      text:
`━━━━━━━━━━━━━━
Раздел пока в разработке.

Сейчас готовим управление автопостингом.
━━━━━━━━━━━━━━`,
      attachments: mainMenuKeyboard(),
    });
    return;
  }

  await sendMaxMessage({
    chatId,
    text: 'Я пока не понял команду. Откройте главное меню:',
    attachments: mainMenuKeyboard(),
  });
}

