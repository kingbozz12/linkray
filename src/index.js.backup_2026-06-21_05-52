function normalizeCommandText(text) {
  return String(text || '')
    .replace(/[\uFE0F]/g, '')
    .replace(/\s+/g, ' ')
    .trim()
    .toLowerCase();
}

function hasCommand(text, command) {
  return normalizeCommandText(text).includes(String(command || '').toLowerCase());
}

function getUpdateType(update) {
  return update.update_type || update.updateType || update.type || update.event_type || null;
}

function getChatId(update) {
  return (
    update.chat_id ||
    update.chatId ||
    update.chat?.chat_id ||
    update.chat?.chatId ||
    update.chat?.id ||
    update.message?.recipient?.chat_id ||
    update.message?.recipient?.chatId ||
    update.message?.chat_id ||
    update.message?.chatId ||
    update.message?.chat?.chat_id ||
    update.message?.chat?.chatId ||
    update.message?.chat?.id ||
    null
  );
}

function getUserId(update) {
  return (
    update.user_id ||
    update.userId ||
    update.user?.user_id ||
    update.user?.userId ||
    update.user?.id ||
    update.message?.sender?.user_id ||
    update.message?.sender?.userId ||
    update.message?.sender?.id ||
    update.message?.sender_id ||
    update.message?.senderId ||
    null
  );
}

function getMessageText(update) {
  return (
    update.message?.body?.text ||
    update.message?.text ||
    update.body?.text ||
    update.text ||
    ''
  ).trim();
}

function getChatTitleFromUpdate(update) {
  return (
    update.chat?.title ||
    update.chat?.name ||
    update.chat_title ||
    update.chatTitle ||
    update.title ||
    update.message?.chat?.title ||
    update.message?.chat?.name ||
    null
  );
}

function getChatLinkFromUpdate(update) {
  return (
    update.chat?.link ||
    update.chat?.invite_link ||
    update.chat?.inviteLink ||
    update.chat_link ||
    update.chatLink ||
    update.link ||
    null
  );
}

function channelName(channel) {
  return channel.title || 'Без названия';
}

function channelMarkdown(channel) {
  const name = channelName(channel);

  if (channel.link) {
    return `[${name}](${channel.link})`;
  }

  return `${name} — закрытый канал`;
}

function channelsMarkdown(channels) {
  if (!channels.length) {
    return 'не выбраны';
  }

  return channels.map((channel) => `• ${channelMarkdown(channel)}`).join('\n');
}

function cleanChannelButtonText(text) {
  return String(text || '')
    .replace(/^📡\s*/u, '')
    .replace(/^✅\s*/u, '')
    .replace(/^▫️\s*/u, '')
    .replace(/^▫\s*/u, '')
    .replace(/^📣\s*/u, '')
    .replace(/^📌\s*/u, '')
    .trim();
}

