function parsePublishAt(text) {
  const value = String(text || '').toLowerCase().trim();
  const now = new Date();

  let match = value.match(/^через\s+(\d+)\s*(мин|минут|минуту|минуты)$/i);
  if (match) {
    const minutes = Number(match[1]);
    return new Date(now.getTime() + minutes * 60 * 1000);
  }

  match = value.match(/^через\s+(\d+)\s*(час|часа|часов)$/i);
  if (match) {
    const hours = Number(match[1]);
    return new Date(now.getTime() + hours * 60 * 60 * 1000);
  }

  match = value.match(/^(\d{1,2}):(\d{2})$/);
  if (match) {
    const hours = Number(match[1]);
    const minutes = Number(match[2]);

    const publishAt = new Date(now);
    publishAt.setHours(hours, minutes, 0, 0);

    if (publishAt.getTime() <= now.getTime()) {
      publishAt.setDate(publishAt.getDate() + 1);
    }

    return publishAt;
  }

  match = value.match(/^(\d{4})-(\d{2})-(\d{2})\s+(\d{1,2}):(\d{2})$/);
  if (match) {
    const [, year, month, day, hour, minute] = match;
    return new Date(
      Number(year),
      Number(month) - 1,
      Number(day),
      Number(hour),
      Number(minute),
      0,
      0
    );
  }

  return null;
}

function formatDate(date) {
  return date.toLocaleString('ru-RU', {
    timeZone: 'Europe/Moscow',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
  });
}

async function handleBack(chatId, userId, session) {
  if (session.state === 'select_channel' || session.state === 'select_channels_multi') {
    await clearSession(userId);
    await sendPostingMenu(chatId);
    return;
  }

  if (session.state === 'wait_post_text') {
    await sendChannelSelection(chatId, userId);
    return;
  }

  if (session.state === 'wait_publish_time') {
    await askPostText(chatId, userId, session.data.channelIds || []);
    return;
  }

  if (session.state === 'confirm_post') {
    await askPublishTime(chatId, userId, {
      channelIds: session.data.channelIds || [],
      postText: session.data.postText,
    });
    return;
  }

  await clearSession(userId);
  await sendPostingMenu(chatId);
}

async function handleActiveSession(chatId, userId, text, session) {
  if (session.state === 'select_channel') {
    if (hasCommand(text, 'Выбрать несколько')) {
      await sendMultiChannelSelection(chatId, userId, []);
      return true;
    }

    if (hasCommand(text, 'Все каналы')) {
      const channels = await getChannels();
      await askPostText(chatId, userId, channels.map((channel) => Number(channel.id)));
      return true;
    }

    if (hasCommand(text, 'Добавить канал')) {
      await clearSession(userId);
      await sendAddChannelInfo(chatId);
      return true;
    }

    const channel = await findChannelByButtonText(text);

    if (!channel) {
      await sendMaxMessage({
        chatId,
        text: 'Выберите канал кнопкой ниже.',
        attachments: wizardNavKeyboard(),
      });
      return true;
    }

    await askPostText(chatId, userId, [Number(channel.id)]);
    return true;
  }

  if (session.state === 'select_channels_multi') {
    const selectedChannelIds = (session.data.selectedChannelIds || []).map(Number);

    if (hasCommand(text, 'Все каналы')) {
      const channels = await getChannels();
await askPostText(chatId, userId, channels.map((channel) => Number(channel.id)));
      return true;
    }

    if (hasCommand(text, 'Далее')) {
      if (!selectedChannelIds.length) {
        await sendMaxMessage({
          chatId,
          text: 'Выберите хотя бы один канал.',
          attachments: wizardNavKeyboard(),
        });
        return true;
      }

      await askPostText(chatId, userId, selectedChannelIds);
      return true;
    }

    const channel = await findChannelByButtonText(text);

    if (!channel) {
      await sendMaxMessage({
        chatId,
        text: 'Выберите канал кнопкой ниже.',
        attachments: wizardNavKeyboard(),
      });
      return true;
    }

    const id = Number(channel.id);
    const nextSelected = selectedChannelIds.includes(id)
      ? selectedChannelIds.filter((channelId) => channelId !== id)
      : [...selectedChannelIds, id];

    await sendMultiChannelSelection(chatId, userId, nextSelected);
    return true;
  }

  if (session.state === 'wait_post_text') {
    await askPublishTime(chatId, userId, {
      ...session.data,
      postText: text,
    });
    return true;
  }

  if (session.state === 'wait_publish_time') {
    const publishAt = parsePublishAt(text);

    if (!publishAt || Number.isNaN(publishAt.getTime())) {
      await sendMaxMessage({
        chatId,
        text:
`Не понял время публикации.

Пример:
\`через 1 минуту\`
или
\`18:30\``,
        attachments: wizardNavKeyboard(),
      });
      return true;
    }

    await askConfirmPost(chatId, userId, {
      ...session.data,
      publishAt: publishAt.toISOString(),
    });
    return true;
  }

  if (session.state === 'confirm_post' && hasCommand(text, 'Подтвердить публикацию')) {
    const data = session.data;
    const channelIds = (data.channelIds || []).map(Number);

    if (!channelIds.length) {
      await sendMaxMessage({
        chatId,
        text: 'Каналы не выбраны. Начните создание поста заново.',
        attachments: postingMenuKeyboard(),
      });
      await clearSession(userId);
      return true;
    }

    for (const channelId of channelIds) {
      await query(
        `
        INSERT INTO scheduled_posts (
          channel_id,
          text,
          format,
          publish_at,
          notify,
          created_by_max_user_id
        )
        VALUES ($1, $2, 'markdown', $3, true, $4)
        `,
        [
          channelId,
          data.postText,
          data.publishAt,
          userId,
        ]
      );
    }

    const channels = await getChannelsByIds(channelIds);

    await clearSession(userId);

    await sendMaxMessage({
      chatId,
      text:
`━━━━━━━━━━━━━━
🟢 Пост запланирован

Каналы:
${channelsMarkdown(channels)}

Публикация:
\`${formatDate(new Date(data.publishAt))}\`

Создано задач: **${channelIds.length}**
━━━━━━━━━━━━━━`,
      attachments: postingMenuKeyboard(),
    });
    return true;
  }

  return false;
}


function getCallbackId(update) {
  return (
    update.callback?.callback_id ||
    update.callback?.callbackId ||
    update.callback_id ||
    update.callbackId ||
    null
  );
}

function getCallbackPayload(update) {
  return (
    update.callback?.payload ||
    update.payload ||
    update.callback?.button?.payload ||
    ''
  );
}

