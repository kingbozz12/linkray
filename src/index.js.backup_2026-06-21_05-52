function makeSingleChannelKeyboard(channels) {
  const rows = [];

  for (let i = 0; i < channels.length; i += 2) {
    const row = [];

    row.push(callbackButton(`📡 ${channelName(channels[i])}`, `post:single:${channels[i].id}`));

    if (channels[i + 1]) {
      row.push(callbackButton(`📡 ${channelName(channels[i + 1])}`, `post:single:${channels[i + 1].id}`));
    }

    rows.push(row);
  }

  rows.push([callbackButton('🧩 Выбрать несколько', 'post:multi')]);
  rows.push([callbackButton('🌐 Все каналы', 'post:all')]);
  rows.push([callbackButton('🔗 Добавить канал', 'post:add_channel')]);
  rows.push([callbackButton('⬅️ Назад', 'post:back')]);
  rows.push([callbackButton('❌ Отмена', 'post:cancel')]);

  return inlineKeyboard(rows);
}

function makeMultiChannelKeyboard(channels, selectedIds = []) {
  const selectedSet = new Set(selectedIds.map(Number));
  const rows = [];

  for (let i = 0; i < channels.length; i += 2) {
    const row = [];

    const first = channels[i];
    row.push(callbackButton(
      `${selectedSet.has(Number(first.id)) ? '✅' : '▫️'} ${channelName(first)}`,
      `post:toggle:${first.id}`
    ));

    if (channels[i + 1]) {
      const second = channels[i + 1];
      row.push(callbackButton(
        `${selectedSet.has(Number(second.id)) ? '✅' : '▫️'} ${channelName(second)}`,
        `post:toggle:${second.id}`
      ));
    }

    rows.push(row);
  }

  rows.push([callbackButton('➡️ Далее', 'post:next')]);
  rows.push([callbackButton('🌐 Все каналы', 'post:all')]);
  rows.push([callbackButton('⬅️ Назад', 'post:back')]);
  rows.push([callbackButton('❌ Отмена', 'post:cancel')]);

  return inlineKeyboard(rows);
}

