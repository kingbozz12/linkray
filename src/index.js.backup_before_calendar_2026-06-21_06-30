    try {
      await sendMaxMessage({
        chatId: channel.max_chat_id,
        text: buildPostText(draft),
        attachments: buildPostAttachments(draft),
        notify: draft.notify,
      });

      results.push({ channel, ok: true });
    } catch (error) {
      console.error('[publish] failed:', channel.max_chat_id, error.message || error);
      results.push({ channel, ok: false, error: error.message });
    }
  }

  return results;
}

async function schedulePost(draft, userId, publishAt) {
  for (const channelId of draft.channelIds || []) {
    await query(
      `
      INSERT INTO scheduled_posts (channel_id, text, format, publish_at, notify, created_by_max_user_id)
      VALUES ($1, $2, 'markdown', $3, $4, $5)
      `,
      [channelId, buildPostText(draft), publishAt.toISOString(), draft.notify, userId]
    );
  }
}

async function textScheduled(draft, publishAt) {
  const channels = await getChannelsByIds(draft.channelIds);

  const ad = draft.isAd
    ? `да${draft.cpm ? `, ${draft.cpm} ₽ / 1000 просмотров` : ', ставка не указана'}`
    : 'нет';

  return `━━━━━━━━━━━━━━
✅ **Публикация запланирована**

📅 ${formatMsk(publishAt)} МСК

Каналы:
${channelsList(channels)}

Параметры:
🔔 Звук: ${draft.notify ? 'включён' : 'выключен'}
🗑 Автоудаление: ${draft.autoDeleteMinutes ? formatMinutes(draft.autoDeleteMinutes) : 'нет'}
💼 Реклама: ${ad}
📊 Отчёт: через ${draft.reportAfterHours || 24}ч

После публикации LinkRay начнёт собирать статистику.
━━━━━━━━━━━━━━`;
}

async function handleMessage(update) {
  const chatId = getChatId(update);
  const userId = getUserId(update);
  const text = getMessageText(update);

  console.log('[message]', JSON.stringify({ chatId, userId, text }));

  if (!chatId || !userId) return;

  const session = await getSession(userId);
  const draft = safeDraft(session.data);

  if (session.state === 'wait_post_content') {
    draft.content = extractContent(update);
    await sendEditor(chatId, userId, draft);
    return;
  }

  if (session.state === 'edit_text') {
    draft.content.text = text;
    await sendEditor(chatId, userId, draft);
    return;
  }

  if (session.state === 'add_media') {
    const attachments = getAttachments(update);

    if (!attachments.length) {
      await sendPrompt(
        chatId,
        userId,
        'add_media',
        draft,
        `━━━━━━━━━━━━━━
🖼 **Медиа**

Отправьте фото, видео или файл.
━━━━━━━━━━━━━━`
      );
      return;
    }

    draft.content.attachments = attachments;
    draft.content.kind = 'media';
    await sendEditor(chatId, userId, draft);
    return;
  }

  if (session.state === 'add_button') {
    const button = parsePostButton(text);

    if (!button) {
      await sendPrompt(
        chatId,
        userId,
        'add_button',
        draft,
        `━━━━━━━━━━━━━━
🔘 **Кнопка под пост**

Введите в формате:
Название кнопки - ссылка

Пример:
Наш канал - https://example.com
━━━━━━━━━━━━━━`
      );
      return;
    }

    draft.buttons.push(button);
    await sendEditor(chatId, userId, draft);
    return;
  }

  if (session.state === 'wait_signature') {
    draft.signature = text;
    await sendEditor(chatId, userId, draft);
    return;
  }

  if (session.state === 'wait_cpm') {
    const cpm = parseCpm(text);

    if (!cpm) {
      await sendPrompt(
        chatId,
        userId,
        'wait_cpm',
        draft,
        `━━━━━━━━━━━━━━
💰 **Ставка за 1000 просмотров**

Введите число. Например: 1000
━━━━━━━━━━━━━━`
      );
      return;
    }

    draft.isAd = true;
    draft.cpm = cpm;
    await sendEditor(chatId, userId, draft);
    return;
  }

  if (session.state === 'wait_schedule_time') {
    const publishAt = parsePublishTime(text);

    if (!publishAt) {
      await sendPrompt(
        chatId,
        userId,
        'wait_schedule_time',
        draft,
        `━━━━━━━━━━━━━━
🕒 **Время публикации**

Не понял время.

Примеры:
18:30
0235
через 1 минуту
2026-06-23 18:30
━━━━━━━━━━━━━━`,
        'schedule:back'
      );
      return;
    }

    const p = mskParts(publishAt);
    draft.lastTime = `${String(p.hour).padStart(2, '0')}:${String(p.minute).padStart(2, '0')}`;

    await schedulePost(draft, userId, publishAt);
    await clearSession(userId);

    await sendMaxMessage({
      chatId,
      text: await textScheduled(draft, publishAt),
      attachments: kbFinal(),
    });
    return;
  }

  if (text === '/start' || norm(text) === 'меню' || hasText(text, 'главное меню')) {
    await clearSession(userId);
    await sendMainMenu(chatId);
    return;
  }

  if (hasText(text, 'постинг')) {
    await sendPosting(chatId, userId);
    return;
  }

  if (hasText(text, 'создать пост')) {
    const newDraft = emptyDraft();

    await setSession(userId, 'select_channel', { draft: newDraft });

    await sendMaxMessage({
      chatId,
      text: `━━━━━━━━━━━━━━
📝 **Новый пост**

Нажмите кнопку ниже, чтобы выбрать канал.
━━━━━━━━━━━━━━`,
      attachments: inlineKeyboard([[callbackButton('📡 Выбрать канал', 'post:create')]]),
    });
    return;
  }

  await sendMaxMessage({
    chatId,
    text: `━━━━━━━━━━━━━━
Я пока не понял команду.

Откройте меню кнопкой ниже.
━━━━━━━━━━━━━━`,
    attachments: kbMain(),
  });
}

async function handleCallback(update) {
  const callbackId = getCallbackId(update);
  const payload = getCallbackPayload(update);
  const userId = getUserId(update);

  console.log('[callback]', JSON.stringify({ callbackId, userId, payload }));

  if (!callbackId || !userId) return;

  const session = await getSession(userId);
  let draft = safeDraft(session.data);

  if (payload === 'main:menu') {
    await clearSession(userId);
    await editMainMenu(callbackId);
    return;
  }

  if (payload === 'main:posting') {
    await editPosting(callbackId, userId);
    return;
  }

  if (payload === 'main:stub') {
    await answerCallback({
      callbackId,
      text: `━━━━━━━━━━━━━━
Раздел в разработке.

Сейчас готовим модуль постинга.
━━━━━━━━━━━━━━`,
      attachments: kbMain(),
    });
    return;
  }

  if (payload === 'post:cancel') {
    await clearSession(userId);
    await answerCallback({
      callbackId,
      text: `━━━━━━━━━━━━━━
❌ Действие отменено
━━━━━━━━━━━━━━`,
      attachments: kbPosting(),
    });
    return;
  }

  if (payload === 'post:back') {
    if (session.state === 'select_channel' || session.state === 'select_channels_multi' || session.state === 'add_channel_info') {
      await editPosting(callbackId, userId);
      return;
    }

    if (session.state === 'wait_post_content') {
      await editChannelSelect(callbackId, userId, draft, false);
      return;
    }

    if (['post_editor', 'edit_text', 'add_media', 'add_button', 'wait_signature', 'wait_cpm'].includes(session.state)) {
      await editWaitPost(callbackId, userId, draft);
      return;
    }

    await editPosting(callbackId, userId);
    return;
  }

  if (payload === 'post:create') {
    draft = emptyDraft();
    await editChannelSelect(callbackId, userId, draft, false);
    return;
  }

  if (payload === 'post:add_channel') {
    await setSession(userId, 'add_channel_info', {});

    await answerCallback({
      callbackId,
      text: `━━━━━━━━━━━━━━
🔗 **Добавить канал**

Чтобы LinkRay мог публиковать посты:

1. Откройте канал в MAX
2. Добавьте бота LinkRay в администраторы
3. Выдайте право публиковать сообщения
4. Вернитесь в **Мои каналы**

После добавления канал появится автоматически.
━━━━━━━━━━━━━━`,
      attachments: inlineKeyboard([
        [callbackButton('📁 Мои каналы', 'post:channels')],
        [callbackButton('⬅️ Назад', 'post:back')],
      ]),
    });
    return;
  }

  if (payload === 'post:channels') {
    await refreshAllChannelsMeta();
    const channels = await getChannels();

    if (!channels.length) {
      await answerCallback({
        callbackId,
        text: `━━━━━━━━━━━━━━
📁 **Мои каналы**

Пока нет каналов.
Добавьте LinkRay в администраторы канала.
━━━━━━━━━━━━━━`,
        attachments: inlineKeyboard([
          [callbackButton('🔗 Добавить канал', 'post:add_channel')],
          [callbackButton('⬅️ Назад', 'post:back')],
        ]),
      });
      return;
    }

    const list = channels.map((c, i) => `${i + 1}. ${channelLine(c)}`).join('\n');

    await answerCallback({
      callbackId,
      text: `━━━━━━━━━━━━━━
📁 **Мои каналы**

${list}
━━━━━━━━━━━━━━`,
      attachments: inlineKeyboard([
        [callbackButton('➕ Создать пост', 'post:create')],
        [callbackButton('🔗 Добавить канал', 'post:add_channel')],
        [callbackButton('⬅️ Назад', 'post:back')],
      ]),
    });
    return;
  }

  if (payload === 'post:multi') {
    await editChannelSelect(callbackId, userId, draft, true);
    return;
  }

  if (payload.startsWith('post:toggle:')) {
    const id = Number(payload.split(':')[2]);
    const set = new Set(draft.channelIds.map(Number));

    if (set.has(id)) set.delete(id);
    else set.add(id);

    draft.channelIds = [...set];

    await editChannelSelect(callbackId, userId, draft, true);
    return;
  }

  if (payload === 'post:multi_next') {
    if (!draft.channelIds.length) {
      await editChannelSelect(callbackId, userId, draft, true);
      return;
    }

    await editWaitPost(callbackId, userId, draft);
    return;
  }

  if (payload === 'post:all') {
    const channels = await getChannels();
    draft.channelIds = channels.map((c) => Number(c.id));

    await editWaitPost(callbackId, userId, draft);
    return;
  }

  if (payload.startsWith('post:single:')) {
    draft.channelIds = [Number(payload.split(':')[2])];

    await editWaitPost(callbackId, userId, draft);
    return;
  }

  if (payload === 'editor:text') {
    await editPrompt(
      callbackId,
      userId,
      'edit_text',
      draft,
      `━━━━━━━━━━━━━━
✏️ **Редактирование текста**

Отправьте новый текст поста одним сообщением.
━━━━━━━━━━━━━━`
    );
    return;
  }

  if (payload === 'editor:media') {
    await editPrompt(
      callbackId,
      userId,
      'add_media',
      draft,
      `━━━━━━━━━━━━━━
🖼 **Медиа**

Отправьте фото, видео или файл.
━━━━━━━━━━━━━━`
    );
    return;
  }

  if (payload === 'editor:button') {
    await editPrompt(
      callbackId,
      userId,
      'add_button',
      draft,
      `━━━━━━━━━━━━━━
🔘 **Кнопка под пост**

Введите кнопку в формате:
Название кнопки - ссылка

Пример:
Наш канал - https://example.com
━━━━━━━━━━━━━━`
    );
    return;
  }

  if (payload === 'editor:signature') {
    await editPrompt(
      callbackId,
      userId,
      'wait_signature',
      draft,
      `━━━━━━━━━━━━━━
🏷 **Автоподпись**

Отправьте текст автоподписи.
Она будет добавлена в конец поста.
━━━━━━━━━━━━━━`
    );
    return;
  }

  if (payload === 'editor:ad') {
    draft.isAd = !draft.isAd;

    if (!draft.isAd) draft.cpm = null;

    await editEditor(callbackId, userId, draft);
    return;
  }

  if (payload === 'editor:cpm') {
    await editPrompt(
      callbackId,
      userId,
      'wait_cpm',
      draft,
      `━━━━━━━━━━━━━━
💰 **Ставка за 1000 просмотров**

Введите цену за 1000 просмотров.

Пример:
1000
━━━━━━━━━━━━━━`
    );
    return;
  }

  if (payload === 'editor:next') {
    await editPublish(callbackId, userId, draft);
    return;
  }

  if (payload === 'publish:back') {
    await editEditor(callbackId, userId, draft);
    return;
  }

  if (payload === 'publish:sound') {
    draft.notify = !draft.notify;
    await editPublish(callbackId, userId, draft);
    return;
  }

  if (payload === 'publish:channels') {
    await editChannelSelect(callbackId, userId, draft, false);
    return;
  }

  if (payload === 'publish:auto_delete') {
    await setSession(userId, 'auto_delete_settings', { draft });

    await answerCallback({
      callbackId,
      text: `━━━━━━━━━━━━━━
🗑 **Автоудаление**

Через сколько удалить пост после публикации?
━━━━━━━━━━━━━━`,
      attachments: kbAutoDelete(),
    });
    return;
  }

  if (payload.startsWith('autodel:')) {
    const value = payload.split(':')[1];

    if (value === 'back') {
      await editPublish(callbackId, userId, draft);
      return;
    }

    draft.autoDeleteMinutes = value === 'none' ? null : Number(value);

    await editPublish(callbackId, userId, draft);
    return;
  }

  if (payload === 'publish:schedule') {
    await setSession(userId, 'schedule_menu', { draft });

    await answerCallback({
      callbackId,
      text: `━━━━━━━━━━━━━━
📅 **Планирование**

Введите время вручную или выберите быстрый вариант.

Примеры:
18:30
0235
через 1 минуту
2026-06-23 18:30
━━━━━━━━━━━━━━`,
      attachments: kbSchedule(draft),
    });
    return;
  }

  if (payload === 'schedule:back') {
    await editPublish(callbackId, userId, draft);
    return;
  }

  if (payload === 'schedule:manual') {
    await editPrompt(
      callbackId,
      userId,
      'wait_schedule_time',
      draft,
      `━━━━━━━━━━━━━━
🕒 **Время публикации**

Отправьте время сообщением.

Примеры:
18:30
0235
через 1 минуту
2026-06-23 18:30
━━━━━━━━━━━━━━`,
      'schedule:back'
    );
    return;
  }

  if (payload.startsWith('schedule:quick:')) {
    const time = payload.replace('schedule:quick:', '');
    const publishAt = parsePublishTime(time);

    if (!publishAt) {
      await editPublish(callbackId, userId, draft);
      return;
    }

    draft.lastTime = time;

    await schedulePost(draft, userId, publishAt);
    await clearSession(userId);

    await answerCallback({
      callbackId,
      text: await textScheduled(draft, publishAt),
      attachments: kbFinal(),
    });
    return;
  }

  if (payload === 'publish:now') {
    const results = await publishNow(draft);
    const ok = results.filter((r) => r.ok).length;
    const channels = await getChannelsByIds(draft.channelIds);

    await clearSession(userId);

    await answerCallback({
      callbackId,
      text: `━━━━━━━━━━━━━━
✅ **Пост опубликован**

Каналы:
${channelsList(channels)}

Опубликовано: **${ok} из ${results.length}**

📊 Отчёт будет готов через ${draft.reportAfterHours || 24}ч.
━━━━━━━━━━━━━━`,
      attachments: kbFinal(),
    });
    return;
  }

  await answerCallback({
    callbackId,
    text: `━━━━━━━━━━━━━━
Команда пока не обработана.
━━━━━━━━━━━━━━`,
    attachments: kbPosting(),
  });
}

