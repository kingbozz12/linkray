js_path.write_text(js, encoding="utf-8")
css_path.write_text(css, encoding="utf-8")
html_path.write_text(html, encoding="utf-8")

print("Публикации и PNG-отчёт исправлены")
PY

echo "[3/8] Проверяю JavaScript"

node --check "$JS"

grep -q "LINKRAY_POST_PREVIEW_PNG_V1" "$JS"
grep -q "postPlainText" "$JS"
grep -q "drawReportChart" "$JS"
grep -q "LINKRAY_POST_PREVIEW_PNG_V1_START" "$CSS"

