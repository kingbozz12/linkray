css = css.rstrip() + "\n\n" + css_block.strip() + "\n"

version = "20260806-post-preview-png-v1"

html = re.sub(
    r'cabinet-stable\.js(?:\?v=[^"\']*)?',
    f'cabinet-stable.js?v={version}',
