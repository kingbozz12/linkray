#!/usr/bin/env bash
set -Eeuo pipefail

cd /opt/linkray

INDEX="public/linkray-site/index.html"
BACKUP="$(mktemp -d /tmp/linkray-faq-ready-v2.XXXXXX)"
DONE=0

restore_index() {
  echo
  echo "[ОТКАТ] Возвращаю прежний FAQ"

  cp -f "$BACKUP/index.html" "$INDEX"
  docker compose up -d --build app >/dev/null 2>&1 || true

  echo "[ОТКАТ] Предыдущий FAQ восстановлен"
}

on_error() {
  code=$?

  if [[ "$DONE" != "1" ]]; then
    restore_index
  fi

  exit "$code"
}

trap on_error ERR

echo "[1/7] Проверяю главную страницу"

test -f "$INDEX"
cp -f "$INDEX" "$BACKUP/index.html"

python3 - <<'PY'
