        "Добавьте LinkRay администратором канала с необходимыми "
        "правами и перешлите боту любой пост из этого канала.",
    ),
    (
        "Что показывает личный кабинет?",
        "В кабинете доступны подключённые каналы, подписчики, "
        "просмотры, прирост аудитории, ER, графики, состояние "
        "аналитики, AntiFraud и последние публикации.",
    ),
    (
        "Сайт заменяет бота?",
        "Нет. Сайт и бот работают вместе: кабинет показывает "
        "данные и отчёты, а создание и редактирование публикаций "
        "выполняется в LinkRay Studio внутри MAX.",
    ),
    (
        "Когда становится доступен полный отчёт?",
        "Текущие показатели появляются по мере сбора данных. "
        "Полный графический отчёт становится доступен после "
        "накопления минимум 24 часов аналитики по каналу.",
    ),
    (
        "Сайт работает на телефоне?",
        "Да. Главная страница и личный кабинет адаптированы "
        "для телефонов, планшетов и компьютеров и открываются "
        "в обычном браузере.",
    ),
]

def tag_attribute(tag, name):
    match = re.search(
        rf"\b{re.escape(name)}\s*=\s*(['\"])(.*?)\1",
        tag,
        flags=re.I | re.S,
    )
    return match.group(2).strip() if match else ""

def find_section_bounds(document, section_id):
    start_match = None

    for match in re.finditer(
        r"<section\b[^>]*>",
        document,
        flags=re.I | re.S,
    ):
        tag = match.group(0)

        if tag_attribute(tag, "id") == section_id:
            start_match = match
            break

    if start_match is None:
        return None

    depth = 0

    for token in re.finditer(
        r"</?section\b[^>]*>",
        document[start_match.start():],
        flags=re.I | re.S,
    ):
        tag = token.group(0)
        absolute_end = start_match.start() + token.end()

        if tag.lower().startswith("</section"):
            depth -= 1

            if depth == 0:
                return start_match.start(), absolute_end
        else:
            depth += 1

    raise SystemExit(
        f"Не найден закрывающий тег секции #{section_id}"
    )

def details_html(indent):
    blocks = []

    for question, answer in questions:
        blocks.append(
            indent + "<details>\n"
            + indent + "  <summary>"
            + html.escape(question)
            + "</summary>\n"
            + indent + "  <p>"
            + html.escape(answer)
            + "</p>\n"
            + indent + "</details>"
        )

    return "\n\n".join(blocks)

mobile = (
    '<section id="lr-mobile-faq" class="lr-m-section lr-m-faq">\n'
    '  <div class="lr-m-section-head">\n'
    '    <span>FAQ</span>\n'
    '    <h2>Частые вопросы</h2>\n'
    '    <p>Вход, подключение каналов, кабинет и отчёты.</p>\n'
    '  </div>\n\n'
    '  <div class="lr-m-faq-list">\n'
    + details_html("    ")
    + '\n  </div>\n'
    '</section>'
)

desktop = (
    '<section class="section" id="faq">\n'
    '  <div class="shell faq-grid">\n'
    '    <div class="section-heading reveal">\n'
    '      <span class="section-kicker">FAQ</span>\n'
    '      <h2>Частые вопросы</h2>\n'
    '      <p>Вход, подключение каналов, кабинет и отчёты.</p>\n'
    '    </div>\n\n'
    '    <div class="faq-list reveal">\n'
    + details_html("      ")
    + '\n    </div>\n'
    '  </div>\n'
    '</section>'
)

mobile_bounds = find_section_bounds(
    source,
    "lr-mobile-faq",
)

desktop_bounds = find_section_bounds(
    source,
    "faq",
)

if mobile_bounds is None:
    raise SystemExit(
        "На главной странице не найдена мобильная секция FAQ"
    )

if desktop_bounds is None:
    raise SystemExit(
        "На главной странице не найдена основная секция FAQ"
    )

replacements = [
    (
        mobile_bounds[0],
        mobile_bounds[1],
        mobile,
    ),
    (
        desktop_bounds[0],
        desktop_bounds[1],
        desktop,
    ),
]

for start, end, replacement in sorted(
    replacements,
    key=lambda item: item[0],
    reverse=True,
):
    source = source[:start] + replacement + source[end:]

def update_faq_schema(document):
    script_pattern = re.compile(
        r"<script\b([^>]*)>([\s\S]*?)</script>",
        flags=re.I,
    )

    faq_entities = [
        {
            "@type": "Question",
            "name": question,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": answer,
            },
        }
        for question, answer in questions
    ]

    for match in script_pattern.finditer(document):
        attributes = match.group(1)

        type_match = re.search(
            r"\btype\s*=\s*(['\"])(.*?)\1",
            attributes,
            flags=re.I | re.S,
        )

        if (
            not type_match
            or type_match.group(2).strip().lower()
            != "application/ld+json"
        ):
            continue

        raw_json = html.unescape(
            match.group(2)
        ).strip()

        try:
            data = json.loads(raw_json)
        except Exception:
            continue

        nodes = []

        if isinstance(data, dict):
            graph = data.get("@graph")

            if isinstance(graph, list):
                nodes = graph
            else:
                nodes = [data]

        faq_node = next(
            (
                node
                for node in nodes
                if isinstance(node, dict)
                and node.get("@type") == "FAQPage"
            ),
            None,
        )

        if faq_node is None:
            continue

        faq_node["mainEntity"] = faq_entities

        serialized = json.dumps(
            data,
            ensure_ascii=False,
            separators=(",", ":"),
        ).replace("</", "<\\/")

        replacement = (
            "<script"
            + attributes
            + ">"
            + serialized
            + "</script>"
        )

        return (
            document[:match.start()]
            + replacement
            + document[match.end():]
        )

    schema = {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "@id": "https://linkray.ru/#faq",
        "mainEntity": faq_entities,
    }

    schema_tag = (
        '\n<script id="lr-ready-faq-schema-v2" '
        'type="application/ld+json">'
        + json.dumps(
            schema,
            ensure_ascii=False,
            separators=(",", ":"),
        ).replace("</", "<\\/")
        + "</script>\n"
    )

    head_close = re.search(
        r"</head>",
        document,
        flags=re.I,
    )

    if not head_close:
        raise SystemExit(
            "Не найден закрывающий тег </head>"
        )

    return (
        document[:head_close.start()]
        + schema_tag
        + document[head_close.start():]
    )

source = update_faq_schema(source)

path.write_text(source, encoding="utf-8")

print("Мобильный и основной FAQ заменены")
