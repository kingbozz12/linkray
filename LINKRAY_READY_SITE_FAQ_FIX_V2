from pathlib import Path
import json
import re

source = Path(
    "public/linkray-site/index.html"
).read_text(encoding="utf-8")

required_questions = [
    "Как войти в личный кабинет?",
    "Как подключить канал?",
    "Что показывает личный кабинет?",
    "Сайт заменяет бота?",
    "Когда становится доступен полный отчёт?",
    "Сайт работает на телефоне?",
]

for question in required_questions:
    if source.count(question) < 2:
        raise SystemExit(
            f"В двух версиях FAQ отсутствует вопрос: {question}"
        )

if source.count("<h2>Частые вопросы</h2>") < 2:
    raise SystemExit(
        "Заголовок FAQ установлен не в обе версии"
    )

def section_details_count(document, section_id):
    section_start = None

    for match in re.finditer(
        r"<section\b[^>]*>",
        document,
        flags=re.I | re.S,
    ):
        tag = match.group(0)

        id_match = re.search(
            r"\bid\s*=\s*(['\"])(.*?)\1",
            tag,
            flags=re.I | re.S,
        )

        if id_match and id_match.group(2) == section_id:
            section_start = match.start()
            break

    if section_start is None:
        return -1

    depth = 0

    for token in re.finditer(
        r"</?section\b[^>]*>",
        document[section_start:],
        flags=re.I | re.S,
    ):
        tag = token.group(0)

        if tag.lower().startswith("</section"):
            depth -= 1

            if depth == 0:
                block = document[
                    section_start:
                    section_start + token.end()
                ]
                return len(
                    re.findall(
                        r"<details\b",
                        block,
                        flags=re.I,
                    )
                )
        else:
            depth += 1

    return -1

if section_details_count(
    source,
    "lr-mobile-faq",
) != 6:
    raise SystemExit(
        "В мобильном FAQ должно быть 6 вопросов"
    )

if section_details_count(
    source,
    "faq",
) != 6:
    raise SystemExit(
        "В основном FAQ должно быть 6 вопросов"
    )

faq_schema_found = False

for match in re.finditer(
    r"<script\b([^>]*)>([\s\S]*?)</script>",
    source,
    flags=re.I,
):
    attributes = match.group(1)

    if "application/ld+json" not in attributes:
        continue

    try:
        data = json.loads(match.group(2).strip())
    except Exception:
        continue

    nodes = []

    if isinstance(data, dict):
        nodes = (
            data.get("@graph")
            if isinstance(data.get("@graph"), list)
            else [data]
        )

    for node in nodes:
        if (
            isinstance(node, dict)
            and node.get("@type") == "FAQPage"
            and len(node.get("mainEntity", [])) == 6
        ):
            faq_schema_found = True

if not faq_schema_found:
    raise SystemExit(
        "FAQ-разметка для поисковиков не обновлена"
    )

print("Локальная проверка FAQ пройдена")
